# App
APP_NAME=go-clean-template
APP_VERSION=1.0.0
# The public origin users reach the app at; the links the app builds point under it
APP_BASE_URL=http://localhost
# HTTP settings
HTTP_PORT=8080
# scaffold:web:begin
# The Vite dev server's port (make dev, make web-dev)
WEB_PORT=3000
# scaffold:web:end
# Logger
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
# Host port the compose db service publishes; PG_URL follows it
PG_PORT=5432
PG_URL=postgres://user:myAwEsOm3pa55%40w0rd@localhost:${PG_PORT}/db
# Scratch database for `make sqlc` only (Atlas renders the HCL schema in it): a throwaway container
# that exists while the command runs. The app applies the schema without one.
ATLAS_DEV_URL=docker://postgres/18/dev
# scaffold:grpc:begin
# gRPC
GRPC_PORT=8081
# scaffold:grpc:end
# Metrics
METRICS_ENABLED=true
# Huma API docs: Stoplight Elements UI under /docs, spec under /openapi.[json|yaml]
DOCS_ENABLED=true
# Tracing
TRACING_ENABLED=true
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=1.0
# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_TOKEN_EXPIRY=15m
# scaffold:queue:begin
# Worker (cmd/worker): polls the queue_messages table
WORKER_POLL_INTERVAL=1s
WORKER_VISIBILITY_TIMEOUT=30s
WORKER_BATCH_SIZE=10
WORKER_SHUTDOWN_TIMEOUT=10s
# scaffold:queue:end
# scaffold:email:begin
# Mail (sent by cmd/worker). Mailpit from make compose-up: SMTP on SMTP_PORT, inbox UI on MAILPIT_UI_PORT
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com
# scaffold:email:end
# Exchange: base URL of the ExchangeRate-API open access endpoint (keyless daily rates)
EXCHANGE_SERVICE_URL=https://open.er-api.com
# scaffold:passkeys:begin
# WebAuthn (passkeys): RP ID is the bare host; origins are comma-separated, no spaces
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=go-clean-template
WEBAUTHN_RP_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080
WEBAUTHN_CEREMONY_TIMEOUT=5m
WEBAUTHN_REAUTH_MAX_AGE=5m
# scaffold:passkeys:end
# scaffold:sso:begin
# OIDC (SSO sign-in): on when OIDC_ISSUER is set. Keycloak from make compose-up, realm keycloak/realm.json.
# OIDC_ROLE_MAP is provider-role:app-role pairs, comma-separated, no spaces
# Host port Keycloak listens on; the issuer follows it
KEYCLOAK_PORT=8180
OIDC_ISSUER=http://keycloak.lvh.me:${KEYCLOAK_PORT}/realms/app
OIDC_CLIENT_ID=go-clean-template
OIDC_CLIENT_SECRET=go-clean-template-dev-secret
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_ROLE_MAP=app-admin:admin,app-user:user
# scaffold:sso:end
