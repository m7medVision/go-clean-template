# App
APP_NAME=go-clean-template
APP_VERSION=1.0.0
# Where the web client is served; links in emails point under it
APP_BASE_URL=http://localhost
# HTTP settings
HTTP_PORT=8080
# Logger
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
# Host port the compose db service publishes; PG_URL follows it
PG_PORT=5432
PG_URL=postgres://user:myAwEsOm3pa55%40w0rd@localhost:${PG_PORT}/db
# Scratch database for `make sqlc` only (Atlas renders the HCL schema in it): a throwaway container
# that exists while the command runs. The app applies the schema without one.
ATLAS_DEV_URL=docker://postgres/18/dev
# gRPC
GRPC_PORT=8081
# Metrics
METRICS_ENABLED=true
# Huma API docs: Stoplight Elements UI under /docs, spec under /openapi.[json|yaml]
DOCS_ENABLED=true
# Tracing
TRACING_ENABLED=true
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=1.0
# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_TOKEN_EXPIRY=24h
# Worker (cmd/worker): polls the queue_messages table
WORKER_POLL_INTERVAL=1s
WORKER_VISIBILITY_TIMEOUT=30s
WORKER_BATCH_SIZE=10
WORKER_SHUTDOWN_TIMEOUT=10s
# Mail (sent by cmd/worker). Mailpit from make compose-up: SMTP on 1025, inbox UI on http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com
