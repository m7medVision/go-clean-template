// The handler is the stub the generator wrote, so this test fails once the handler is written: the
// first real implementation replaces it with tests of what Create{{.Name.Go}} records.
func TestCreate{{.Name.Go}}IsNotImplementedYet(t *testing.T) {
	t.Parallel()

	_, err := command.Create{{.Name.Go}}Handler{Store: memstore.New(entity.EventTypes())}.Handle(context.Background(), command.Create{{.Name.Go}}{UserID: _owner})

	require.ErrorIs(t, err, entity.ErrNotImplemented)
}
