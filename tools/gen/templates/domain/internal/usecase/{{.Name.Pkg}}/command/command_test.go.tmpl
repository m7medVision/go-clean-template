const (
	_owner    = "user-1"
	_{{.Name.Lower}}ID = "{{.Name.Kebab}}-1"
)

// The update and delete handlers change the {{.Name.Words}} through aggregate.Change: this stops compiling
// when the aggregate no longer fits it.
var _ = aggregate.Change[entity.{{.Name.Go}}Aggregate]

// given{{.Name.Go}} is a store holding _owner's {{.Name.Words}}, for the commands that change one.
func given{{.Name.Go}}(t *testing.T) *memstore.Store {
	t.Helper()

	store := memstore.New(entity.EventTypes())
	_, err := store.Save(context.Background(), entity.New{{.Name.Go}}Aggregate(_{{.Name.Lower}}ID, _owner, time.Now()))
	require.NoError(t, err)

	return store
}
