package command_test

import (
	"context"
	"testing"
	"time"

	"{{.Module}}/internal/entity"
	"{{.Module}}/internal/repo/memstore"
	"{{.Module}}/internal/usecase/{{.Name.Pkg}}/command"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

const (
	_owner    = "user-1"
	_{{.Name.Lower}}ID = "{{.Name.Kebab}}-1"
)

// given{{.Name.Go}} is a store holding _owner's {{.Name.Words}}, for the commands that change one.
func given{{.Name.Go}}(t *testing.T) *memstore.Store {
	t.Helper()

	store := memstore.New(entity.EventTypes())
	_, err := store.Save(context.Background(), entity.New{{.Name.Go}}Aggregate(_{{.Name.Lower}}ID, _owner, time.Now()))
	require.NoError(t, err)

	return store
}

func TestThe{{.Name.Go}}CommandsActForTheirUser(t *testing.T) {
	t.Parallel()

	for name, cmd := range map[string]interface {
		CommandName() string
		ActorID() string
	}{
		"Create{{.Name.Go}}": command.Create{{.Name.Go}}{UserID: _owner},
		"Update{{.Name.Go}}": command.Update{{.Name.Go}}{UserID: _owner, {{.Name.Go}}ID: _{{.Name.Lower}}ID},
		"Delete{{.Name.Go}}": command.Delete{{.Name.Go}}{UserID: _owner, {{.Name.Go}}ID: _{{.Name.Lower}}ID},
	} {
		assert.Equal(t, name, cmd.CommandName())
		assert.Equal(t, _owner, cmd.ActorID(), name)
	}
}
