package command_test

import (
	"context"
	"testing"
	"time"

	"{{.Module}}/internal/entity"
	"{{.Module}}/internal/repo/memstore"
	"{{.Module}}/internal/usecase/aggregate"
	"github.com/stretchr/testify/require"
