const (
	_bufSize = 1 << 20
	// _owner is the user the tests sign in as, who owns the stored {{.Name.Words}}.
	_owner = "user-1"
	// _storedAt is when the stored {{.Name.Words}} was created and updated, as the service answers with it.
	_storedAt = "2026-01-02T03:04:05Z"
)

// stored is the {{.Name.Words}} the fake handlers answer with.
func stored() entity.{{.Name.Go}} {
	at := time.Date(2026, time.January, 2, 3, 4, 5, 0, time.UTC)

	return entity.{{.Name.Go}}{ID: "{{.Name.Kebab}}-1", UserID: _owner, CreatedAt: at, UpdatedAt: at}
}

// storedResponse is stored as the service answers with it.
func storedResponse() *pb.{{.Name.Go}}Response {
	return &pb.{{.Name.Go}}Response{Id: "{{.Name.Kebab}}-1", UserId: _owner, CreatedAt: _storedAt, UpdatedAt: _storedAt}
}

// fake{{.Name.Go}} answers every {{.Name.Words}} command and query: commands write stored's ID, queries read
// stored, and every one of them fails with err when it is set. It keeps every message it is sent.
type fake{{.Name.Go}} struct {
	stored entity.{{.Name.Go}}
	err    error

	sent []any
}

// buses registers the fake's handlers on real buses whose one step is keep.
func (f *fake{{.Name.Go}}) buses() cqrs.Buses {
	cmds, qs := cqrs.NewCommands(f.keep), cqrs.NewQueries(f.keep)
	write := func(context.Context) (entity.Written, error) { return entity.Written{ID: f.stored.ID}, f.err }

	cqrs.HandleCommand(cmds, cqrs.HandlerFunc[command.Create{{.Name.Go}}, entity.Written](
		func(ctx context.Context, _ command.Create{{.Name.Go}}) (entity.Written, error) { return write(ctx) }))
	cqrs.HandleCommand(cmds, cqrs.HandlerFunc[command.Update{{.Name.Go}}, entity.Written](
		func(ctx context.Context, _ command.Update{{.Name.Go}}) (entity.Written, error) { return write(ctx) }))
	cqrs.HandleCommand(cmds, cqrs.HandlerFunc[command.Delete{{.Name.Go}}, entity.Written](
		func(ctx context.Context, _ command.Delete{{.Name.Go}}) (entity.Written, error) { return write(ctx) }))

	cqrs.HandleQuery(qs, cqrs.HandlerFunc[query.Get{{.Name.Go}}, entity.{{.Name.Go}}](
		func(context.Context, query.Get{{.Name.Go}}) (entity.{{.Name.Go}}, error) { return f.stored, f.err }))
	cqrs.HandleQuery(qs, cqrs.HandlerFunc[query.List{{.Name.Plural.Go}}, entity.List[entity.{{.Name.Go}}]](
		func(context.Context, query.List{{.Name.Plural.Go}}) (entity.List[entity.{{.Name.Go}}], error) {
			return entity.List[entity.{{.Name.Go}}]{Items: []entity.{{.Name.Go}}{f.stored}, Total: 1}, f.err
		}))

	return cqrs.Buses{Commands: cmds, Queries: qs}
}

// keep is a step that keeps every message the buses carry, in the order they are sent.
func (f *fake{{.Name.Go}}) keep(ctx context.Context, msg cqrs.Message, next cqrs.Next) (any, error) {
	f.sent = append(f.sent, msg.Body)

	return next(ctx)
}

// dial serves the {{.Name.Words}} service over f's buses, behind the auth interceptor, on an in-memory
// listener.
func dial(t *testing.T, f *fake{{.Name.Go}}) (pb.{{.Name.Go}}ServiceClient, *jwt.Manager) {
	t.Helper()

	manager := jwt.New("test-secret", time.Hour)
	lis := bufconn.Listen(_bufSize)
	srv := grpc.NewServer(grpc.UnaryInterceptor(grpcmw.Auth(manager)))
	pb.Register{{.Name.Go}}ServiceServer(srv, grpc{{.Name.Pkg}}.New(f.buses(), slog.New(slog.DiscardHandler)))

	go func() {
		if err := srv.Serve(lis); err != nil && !errors.Is(err, grpc.ErrServerStopped) {
			t.Errorf("grpc serve: %v", err)
		}
	}()

	t.Cleanup(srv.Stop)

	conn, err := grpc.NewClient("passthrough:///bufnet",
		grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) { return lis.DialContext(ctx) }),
		grpc.WithTransportCredentials(insecure.NewCredentials()),
	)
	require.NoError(t, err)
	t.Cleanup(func() { _ = conn.Close() })

	return pb.New{{.Name.Go}}ServiceClient(conn), manager
}

// signedIn is a context whose calls carry _owner's token.
func signedIn(t *testing.T, manager *jwt.Manager) context.Context {
	t.Helper()

	token, err := manager.GenerateToken(_owner, nil)
	require.NoError(t, err)

	return metadata.AppendToOutgoingContext(t.Context(), "authorization", token)
}

// call is one call to one {{.Name.Words}} RPC, with what it answers when the fake handlers succeed and the
// commands and queries it sends them.
type call struct {
	do   func(ctx context.Context, client pb.{{.Name.Go}}ServiceClient) (proto.Message, error)
	want proto.Message
	sent []any
}

// calls are one call to each {{.Name.Words}} RPC.
func calls() map[string]call {
	get := query.Get{{.Name.Go}}{UserID: _owner, {{.Name.Go}}ID: "{{.Name.Kebab}}-1"}

	return map[string]call{
		"create": {
			do: func(ctx context.Context, client pb.{{.Name.Go}}ServiceClient) (proto.Message, error) {
				return client.Create{{.Name.Go}}(ctx, &pb.Create{{.Name.Go}}Request{})
			},
			want: storedResponse(),
			sent: []any{command.Create{{.Name.Go}}{UserID: _owner}, get},
		},
		"get": {
			do: func(ctx context.Context, client pb.{{.Name.Go}}ServiceClient) (proto.Message, error) {
				return client.Get{{.Name.Go}}(ctx, &pb.Get{{.Name.Go}}Request{Id: "{{.Name.Kebab}}-1"})
			},
			want: storedResponse(),
			sent: []any{get},
		},
		"list": {
			do: func(ctx context.Context, client pb.{{.Name.Go}}ServiceClient) (proto.Message, error) {
				return client.List{{.Name.Plural.Go}}(ctx, &pb.List{{.Name.Plural.Go}}Request{Limit: 5, Offset: 10})
			},
			want: &pb.List{{.Name.Plural.Go}}Response{ {{- .Name.Plural.Go}}: []*pb.{{.Name.Go}}Response{storedResponse()}, Total: 1},
			sent: []any{query.List{{.Name.Plural.Go}}{UserID: _owner, Limit: 5, Offset: 10}},
		},
		"update": {
			do: func(ctx context.Context, client pb.{{.Name.Go}}ServiceClient) (proto.Message, error) {
				return client.Update{{.Name.Go}}(ctx, &pb.Update{{.Name.Go}}Request{Id: "{{.Name.Kebab}}-1"})
			},
			want: storedResponse(),
			sent: []any{command.Update{{.Name.Go}}{UserID: _owner, {{.Name.Go}}ID: "{{.Name.Kebab}}-1"}, get},
		},
		"delete": {
			do: func(ctx context.Context, client pb.{{.Name.Go}}ServiceClient) (proto.Message, error) {
				return client.Delete{{.Name.Go}}(ctx, &pb.Delete{{.Name.Go}}Request{Id: "{{.Name.Kebab}}-1"})
			},
			want: &pb.Delete{{.Name.Go}}Response{},
			sent: []any{command.Delete{{.Name.Go}}{UserID: _owner, {{.Name.Go}}ID: "{{.Name.Kebab}}-1"}},
		},
	}
}

func TestEach{{.Name.Go}}RPCDecodesTheRequestAndEncodesTheAnswer(t *testing.T) {
	t.Parallel()

	for name, c := range calls() {
		t.Run(name, func(t *testing.T) {
			t.Parallel()

			fake := &fake{{.Name.Go}}{stored: stored()}
			client, manager := dial(t, fake)

			got, err := c.do(signedIn(t, manager), client)

			require.NoError(t, err)
			assert.True(t, proto.Equal(c.want, got), "got %v, want %v", got, c.want)
			assert.Equal(t, c.sent, fake.sent)
		})
	}
}

// rpcerr's tests own which code each kind of failure gets; this checks that every RPC's failure
// reaches the client. Until the handlers are written, each answers Unimplemented.
func TestEach{{.Name.Go}}RPCAnswersAStubHandlerWithUnimplemented(t *testing.T) {
	t.Parallel()

	for name, c := range calls() {
		t.Run(name, func(t *testing.T) {
			t.Parallel()

			fake := &fake{{.Name.Go}}{stored: stored(), err: fmt.Errorf("handler: %w", entity.ErrNotImplemented)}
			client, manager := dial(t, fake)

			_, err := c.do(signedIn(t, manager), client)

			assert.Equal(t, codes.Unimplemented, status.Code(err), err)
		})
	}
}
