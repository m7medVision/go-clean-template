package {{.Name.Pkg}}

import (
	"context"

	v1 "{{.Module}}/docs/proto/v1"
	"{{.Module}}/internal/controller/authn"
	"{{.Module}}/internal/controller/grpc/v1/rpcerr"
	"{{.Module}}/internal/usecase/{{.Name.Pkg}}/command"
	"{{.Module}}/pkg/cqrs"
)

// Update{{.Name.Go}} sends Update{{.Name.Go}}, then reads the {{.Name.Words}} back. As in Create{{.Name.Go}}, the fields
// of the request go into the command once they are added.
func (c *Controller) Update{{.Name.Go}}(ctx context.Context, req *v1.Update{{.Name.Go}}Request) (*v1.{{.Name.Go}}Response, error) {
	userID := authn.MustCaller(ctx).UserID

	_, err := cqrs.SendCommand(ctx, c.cmds, command.Update{{.Name.Go}}{UserID: userID, {{.Name.Go}}ID: req.GetId()})
	if err != nil {
		return nil, rpcerr.Status(ctx, c.l, err, "Update{{.Name.Go}}")
	}

	resp, err := c.readBack(ctx, userID, req.GetId())
	if err != nil {
		return nil, rpcerr.Status(ctx, c.l, err, "Update{{.Name.Go}}")
	}

	return resp, nil
}
