// Create{{.Name.Go}} sends Create{{.Name.Go}}, then reads the {{.Name.Words}} back. The fields of the request go
// into the command once they are added: name the request to read them.
func (c *Controller) Create{{.Name.Go}}(ctx context.Context, _ *v1.Create{{.Name.Go}}Request) (*v1.{{.Name.Go}}Response, error) {
	userID, ok := grpcmw.UserIDFromContext(ctx)
	if !ok {
		return nil, status.Error(codes.Unauthenticated, "unauthorized")
	}

	written, err := cqrs.SendCommand[cqrs.Written](ctx, c.cmds, command.Create{{.Name.Go}}{UserID: userID})
	if err != nil {
		return nil, c.fail(err, "Create{{.Name.Go}}")
	}

	return c.readBack(ctx, userID, written.ID, "Create{{.Name.Go}}")
}

