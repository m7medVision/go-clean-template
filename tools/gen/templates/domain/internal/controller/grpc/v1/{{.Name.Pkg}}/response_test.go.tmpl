func TestNew{{.Name.Go}}Response(t *testing.T) {
	t.Parallel()

	row := stored()

	resp := grpc{{.Name.Pkg}}.New{{.Name.Go}}Response(&row)

	require.NotNil(t, resp)
	assert.Equal(t, row.ID, resp.GetId())
	assert.Equal(t, row.UserID, resp.GetUserId())
	assert.Equal(t, _storedAt, resp.GetCreatedAt())
	assert.Equal(t, _storedAt, resp.GetUpdatedAt())
}

func TestNewList{{.Name.Plural.Go}}Response(t *testing.T) {
	t.Parallel()

	second := stored()
	second.ID = "{{.Name.Kebab}}-2"

	for name, tc := range map[string]struct {
		rows  []entity.{{.Name.Go}}
		total int
		want  int32
	}{
		"one page":                {rows: []entity.{{.Name.Go}}{stored(), second}, total: 7, want: 7},
		"none":                    {rows: []entity.{{.Name.Go}}{}, total: 0, want: 0},
		"more than int32 can say": {total: math.MaxInt, want: math.MaxInt32},
	} {
		t.Run(name, func(t *testing.T) {
			t.Parallel()

			resp := grpc{{.Name.Pkg}}.NewList{{.Name.Plural.Go}}Response(tc.rows, tc.total)

			require.NotNil(t, resp)
			require.Len(t, resp.Get{{.Name.Plural.Go}}(), len(tc.rows))

			for i := range tc.rows {
				assert.Equal(t, tc.rows[i].ID, resp.Get{{.Name.Plural.Go}}()[i].GetId())
			}

			assert.Equal(t, tc.want, resp.GetTotal())
		})
	}
}
