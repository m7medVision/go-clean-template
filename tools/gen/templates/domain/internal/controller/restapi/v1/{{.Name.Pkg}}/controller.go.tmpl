const _tag = "{{.Name.Plural.Kebab}}"

type controller struct {
	cmds *cqrs.Commands
	qs   *cqrs.Queries
	l    *slog.Logger
}

// NewRoutes registers the {{.Name.Words}} operations. Until its handler is written, each answers 501, which
// its Errors list: drop http.StatusNotImplemented from them once it no longer can.
func NewRoutes(api huma.API, b cqrs.Buses, l *slog.Logger) {
	r := &controller{cmds: b.Commands, qs: b.Queries, l: l}

	r.create{{.Name.Go}}(api)
	r.list{{.Name.Plural.Go}}(api)
	r.get{{.Name.Go}}(api)
	r.update{{.Name.Go}}(api)
	r.delete{{.Name.Go}}(api)
}

func (r *controller) readBack(ctx context.Context, userID, {{.Name.Lower}}ID string) (entity.{{.Name.Go}}, error) {
	return cqrs.SendQuery(ctx, r.qs, query.Get{{.Name.Go}}{UserID: userID, {{.Name.Go}}ID: {{.Name.Lower}}ID})
}
