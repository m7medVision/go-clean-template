// Create{{.Name.Go}} resolves Mutation.create{{.Name.Go}}: it sends Create{{.Name.Go}}, then reads the {{.Name.Words}} back.
// It takes no input until the {{.Name.Words}} has fields: with the first one, give the field the
// argument input: Create{{.Name.Go}}Input! and pass its fields to the command, as createTask does.
func (m Mutation) Create{{.Name.Go}}(ctx context.Context) (*entity.{{.Name.Go}}, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return nil, err
	}

	written, err := cqrs.SendCommand[cqrs.Written](ctx, m.cmds, command.Create{{.Name.Go}}{UserID: caller.UserID})
	if err != nil {
		return nil, gqlerr.Map(m.l, err, "create{{.Name.Go}}")
	}

	return m.readBack(ctx, caller.UserID, written.ID, "create{{.Name.Go}}")
}

// Update{{.Name.Go}} resolves Mutation.update{{.Name.Go}}: it sends Update{{.Name.Go}}, then reads the {{.Name.Words}} back.
// As with Create{{.Name.Go}}, its input comes with the {{.Name.Words}}'s first field.
func (m Mutation) Update{{.Name.Go}}(ctx context.Context, id string) (*entity.{{.Name.Go}}, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return nil, err
	}

	_, err = cqrs.SendCommand[cqrs.Written](ctx, m.cmds, command.Update{{.Name.Go}}{UserID: caller.UserID, {{.Name.Go}}ID: id})
	if err != nil {
		return nil, gqlerr.Map(m.l, err, "update{{.Name.Go}}")
	}

	return m.readBack(ctx, caller.UserID, id, "update{{.Name.Go}}")
}

// Delete{{.Name.Go}} resolves Mutation.delete{{.Name.Go}}.
func (m Mutation) Delete{{.Name.Go}}(ctx context.Context, id string) (bool, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return false, err
	}

	_, err = cqrs.SendCommand[cqrs.Written](ctx, m.cmds, command.Delete{{.Name.Go}}{UserID: caller.UserID, {{.Name.Go}}ID: id})
	if err != nil {
		return false, gqlerr.Map(m.l, err, "delete{{.Name.Go}}")
	}

	return true, nil
}
