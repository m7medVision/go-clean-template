// Package {{.Name.Pkg}} resolves the {{.Name.Words}} fields of the GraphQL schema: each field in the file named as its
// schema file is ({{.Name.Snake}}.go resolves schema/{{.Name.Snake}}.graphqls).
package {{.Name.Pkg}}

import (
	"context"
	"log/slog"

	"{{.Module}}/internal/controller/graphql/gqlerr"
	"{{.Module}}/internal/entity"
	"{{.Module}}/internal/usecase/{{.Name.Pkg}}/query"
	"{{.Module}}/pkg/cqrs"
)

type Query struct {
	qs *cqrs.Queries
	l  *slog.Logger
}

type Mutation struct {
	cmds *cqrs.Commands
	qs   *cqrs.Queries
	l    *slog.Logger
}

func New(b cqrs.Buses, l *slog.Logger) (Query, Mutation) {
	return Query{qs: b.Queries, l: l}, Mutation{cmds: b.Commands, qs: b.Queries, l: l}
}

// result reads back the {{.Name.Words}} a mutation wrote, as its answer.
func (m Mutation) result(ctx context.Context, userID, {{.Name.Lower}}ID, op string) (*entity.{{.Name.Go}}, error) {
	{{.Name.Lower}}, err := cqrs.SendQuery(ctx, m.qs, query.Get{{.Name.Go}}{UserID: userID, {{.Name.Go}}ID: {{.Name.Lower}}ID})
	if err != nil {
		return nil, gqlerr.Map(ctx, m.l, err, op)
	}

	return &{{.Name.Lower}}, nil
}
