func (a *{{.Name.Go}}Aggregate) ownedBy(userID string) error {
	switch {
	case a.deleted:
		return Err{{.Name.Go}}NotFound
	case a.{{.Name.Lower}}.UserID != userID:
		return Err{{.Name.Go}}Forbidden
	default:
		return nil
	}
}

// Update changes userID's {{.Name.Words}}. Check the update's rules here, before it is recorded.
func (a *{{.Name.Go}}Aggregate) Update(userID string, at time.Time) error {
	if err := a.ownedBy(userID); err != nil {
		return err
	}

	Record(a, {{.Name.Go}}Updated{ {{- .Name.Go}}ID: a.{{.Name.Lower}}.ID, At: at})

	return nil
}

// Delete deletes userID's {{.Name.Words}}. Another user's {{.Name.Words}} is Err{{.Name.Go}}NotFound, not
// Err{{.Name.Go}}Forbidden, so a delete never tells a stranger the {{.Name.Words}} exists.
func (a *{{.Name.Go}}Aggregate) Delete(userID string, at time.Time) error {
	if a.deleted || a.{{.Name.Lower}}.UserID != userID {
		return Err{{.Name.Go}}NotFound
	}

	Record(a, {{.Name.Go}}Deleted{ {{- .Name.Go}}ID: a.{{.Name.Lower}}.ID, At: at})

	return nil
}

func (a *{{.Name.Go}}Aggregate) Apply(e Event) {
	switch ev := e.(type) {
	case {{.Name.Go}}Created:
		a.{{.Name.Lower}} = {{.Name.Lower}}State{ID: ev.{{.Name.Go}}ID, UserID: ev.UserID}
	case {{.Name.Go}}Updated: // what an update changes is the read model's until a rule reads it
	case {{.Name.Go}}Deleted:
		a.deleted = true
	}
}

