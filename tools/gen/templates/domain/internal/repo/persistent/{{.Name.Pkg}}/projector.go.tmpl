package {{.Name.Pkg}}

import (
	"context"

	"{{.Module}}/internal/entity"
	"{{.Module}}/internal/repo/persistent/projection"
	"{{.Module}}/internal/repo/persistent/queries"
	"{{.Module}}/pkg/postgres"
)

// NewProjector keeps the {{.Name.Plural.Snake}} table, the {{.Name.Words}} read model, up to date from the {{.Name.Words}} events. The
// worker runs it.
func NewProjector(pg *postgres.Postgres) projection.Projector {
	return projection.NewProjector("{{.Name.Pkg}}", []string{"{{.Name.Plural.Snake}}"}, entity.{{.Name.Go}}Events(), pg, project)
}

// project applies one event to the {{.Name.Plural.Snake}} table through q.
func project(ctx context.Context, q queries.Querier, e *entity.RecordedEvent) error {
	switch ev := e.Event.(type) {
	case entity.{{.Name.Go}}Created:
		return q.Insert{{.Name.Go}}Row(ctx, queries.Insert{{.Name.Go}}RowParams{
			ID: ev.{{.Name.Go}}ID, UserID: ev.UserID, CreatedAt: ev.At, UpdatedAt: ev.At,
		})
	case entity.{{.Name.Go}}Updated:
		return q.Update{{.Name.Go}}Row(ctx, queries.Update{{.Name.Go}}RowParams{ID: ev.{{.Name.Go}}ID, UpdatedAt: ev.At})
	case entity.{{.Name.Go}}Deleted:
		return q.Delete{{.Name.Go}}Row(ctx, ev.{{.Name.Go}}ID)
	default:
		return entity.ErrUnhandledEvent
	}
}
