// Package {{.Name.Pkg}} implements the {{.Name.Words}} read model on Postgres (the {{.Name.Plural.Snake}} table), and the
// projector that writes it from the {{.Name.Words}} events.
package {{.Name.Pkg}}

import (
	"context"
	"errors"
	"fmt"

	"github.com/google/uuid"
