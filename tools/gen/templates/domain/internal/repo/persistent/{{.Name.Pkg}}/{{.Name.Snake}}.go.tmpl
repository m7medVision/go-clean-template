// Repo reads the {{.Name.Plural.Snake}} table. Its queries join the transaction the context carries.
type Repo struct {
	pg *postgres.Postgres
}

func NewReadModel(pg *postgres.Postgres) repo.{{.Name.Go}}ReadModel {
	return &Repo{pg: pg}
}

func (r *Repo) q(ctx context.Context) *queries.Queries {
	return queries.New(r.pg.Executor(ctx))
}

// Get reads the {{.Name.Words}} with {{.Name.Lower}}ID. An ID other than a UUID as the app writes them, in lower case,
// names no {{.Name.Words}}, so it is entity.Err{{.Name.Go}}NotFound, as it is on the write side, not the error
// {{.Name.Plural.Snake}}.id would raise.
func (r *Repo) Get(ctx context.Context, {{.Name.Lower}}ID string) (entity.{{.Name.Go}}, error) {
	if id, err := uuid.Parse({{.Name.Lower}}ID); err != nil || id.String() != {{.Name.Lower}}ID {
		return entity.{{.Name.Go}}{}, entity.Err{{.Name.Go}}NotFound
	}

	row, err := r.q(ctx).Get{{.Name.Go}}(ctx, {{.Name.Lower}}ID)
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return entity.{{.Name.Go}}{}, entity.Err{{.Name.Go}}NotFound
		}

		return entity.{{.Name.Go}}{}, fmt.Errorf("{{.Name.Go}}ReadModel - Get - r.q(ctx).Get{{.Name.Go}}: %w", err)
	}

	return entity.{{.Name.Go}}(row), nil
}

func (r *Repo) List(ctx context.Context, userID string, page entity.Page) (entity.List[entity.{{.Name.Go}}], error) {
	total, err := r.q(ctx).Count{{.Name.Plural.Go}}(ctx, userID)
	if err != nil {
		return entity.List[entity.{{.Name.Go}}]{}, fmt.Errorf("{{.Name.Go}}ReadModel - List - r.q(ctx).Count{{.Name.Plural.Go}}: %w", err)
	}

	rows, err := r.q(ctx).List{{.Name.Plural.Go}}(ctx, queries.List{{.Name.Plural.Go}}Params{
		UserID: userID,
		Limit:  int64(page.Size()),
		Offset: int64(page.Offset),
	})
	if err != nil {
		return entity.List[entity.{{.Name.Go}}]{}, fmt.Errorf("{{.Name.Go}}ReadModel - List - r.q(ctx).List{{.Name.Plural.Go}}: %w", err)
	}

	{{.Name.Plural.Lower}} := make([]entity.{{.Name.Go}}, len(rows))
	for i := range rows {
		{{.Name.Plural.Lower}}[i] = entity.{{.Name.Go}}(rows[i])
	}

	return entity.List[entity.{{.Name.Go}}]{Items: {{.Name.Plural.Lower}}, Total: int(total)}, nil
}
