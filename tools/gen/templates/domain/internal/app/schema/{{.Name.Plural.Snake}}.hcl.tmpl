# The {{.Name.Words}} read model: written only by the {{.Name.Words}} projector, from the {{.Name.Words}} events. It has no
# foreign key to users, because each projector advances on its own and the {{.Name.Words}} one can be ahead.
# Its columns are in the order of entity.{{.Name.Go}}'s fields, so a row converts to one as it is.
table "{{.Name.Plural.Snake}}" {
  schema = schema.public
  column "id" {
    null = false
    type = uuid
  }
  column "user_id" {
    null = false
    type = uuid
  }
  column "created_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  column "updated_at" {
    null    = false
    type    = timestamptz
    default = sql("now()")
  }
  primary_key {
    columns = [column.id]
  }
  index "idx_{{.Name.Plural.Snake}}_user_id" {
    on {
      column = column.user_id
    }
  }
}
