package command_test

import (
	"context"
	"testing"

	"{{.Module}}/internal/entity"
	"{{.Module}}/internal/repo/memstore"
	"{{.Module}}/internal/usecase/{{.Name.Pkg}}/command"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

func Test{{.Usecase.Name.Go}}ActsForItsUser(t *testing.T) {
	t.Parallel()

	cmd := command.{{.Usecase.Name.Go}}{UserID: "user-1"}

	assert.Equal(t, "{{.Usecase.Name.Go}}", cmd.CommandName())
	assert.Equal(t, "user-1", cmd.ActorID())
}

// The handler is the stub the generator wrote, so this test fails once the handler is written: the
// first real implementation replaces it with tests of what {{.Usecase.Name.Go}} records.
func Test{{.Usecase.Name.Go}}IsNotImplementedYet(t *testing.T) {
	t.Parallel()

	h := command.{{.Usecase.Name.Go}}Handler{ {{- .Usecase.Dep}}: memstore.New(entity.EventTypes())}

	_, err := h.Handle(context.Background(), command.{{.Usecase.Name.Go}}{UserID: "user-1"{{if .Usecase.ByID}}, {{.Name.Go}}ID: "{{.Name.Kebab}}-1"{{end}}})

	require.ErrorIs(t, err, entity.ErrNotImplemented)
}
