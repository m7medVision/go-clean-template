// {{.Usecase.Name.Go}} sends {{.Usecase.Name.Go}} and answers with its result. The fields of
// query.{{.Usecase.Name.Go}}Result go into {{.Usecase.Name.Go}}Response: set them from the result here. Those of
// the query come from the request once they are added: put them in {{.Usecase.Name.Go}}Request{{if not .Usecase.ByID}}, and
// name the request to read them{{end}}.
func (c *Controller) {{.Usecase.Name.Go}}(ctx context.Context, {{if .Usecase.ByID}}req{{else}}_{{end}} *v1.{{.Usecase.Name.Go}}Request) (*v1.{{.Usecase.Name.Go}}Response, error) {
	userID := authn.MustCaller(ctx).UserID

	_, err := cqrs.SendQuery(ctx, c.qs, query.{{.Usecase.Name.Go}}{UserID: userID{{if .Usecase.ByID}}, {{.Name.Go}}ID: req.GetId(){{end}}})
	if err != nil {
		return nil, rpcerr.Status(ctx, c.l, err, "{{.Usecase.Name.Go}}")
	}

	return &v1.{{.Usecase.Name.Go}}Response{}, nil
}
