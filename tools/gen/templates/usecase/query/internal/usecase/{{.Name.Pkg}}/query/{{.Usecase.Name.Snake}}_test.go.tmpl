	t.Parallel()

	h := query.{{.Usecase.Name.Go}}Handler{ {{- .Name.Plural.Go}}: repomock.NewMock{{.Name.Go}}ReadModel(gomock.NewController(t))}

	_, err := h.Handle(context.Background(), query.{{.Usecase.Name.Go}}{UserID: "user-1"{{if .Usecase.ByID}}, {{.Name.Go}}ID: "{{.Name.Kebab}}-1"{{end}}})

	require.ErrorIs(t, err, entity.ErrNotImplemented)
}
