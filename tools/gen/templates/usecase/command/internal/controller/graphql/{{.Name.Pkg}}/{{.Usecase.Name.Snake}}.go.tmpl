package {{.Name.Pkg}}

import (
	"context"

	"{{.Module}}/internal/controller/graphql/gqlerr"
	"{{.Module}}/internal/controller/graphql/middleware"
	"{{.Module}}/internal/usecase/{{.Name.Pkg}}/command"
	"{{.Module}}/pkg/cqrs"
)

// {{.Usecase.Name.Go}} answers the ID it wrote. The fields of the command come from the field's arguments
// once they are added.
func (m Mutation) {{.Usecase.Name.Go}}(ctx context.Context{{if .Usecase.ByID}}, id string{{end}}) (string, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return "", err
	}

	written, err := cqrs.SendCommand(ctx, m.cmds, command.{{.Usecase.Name.Go}}{UserID: caller.UserID{{if .Usecase.ByID}}, {{.Name.Go}}ID: id{{end}}})
	if err != nil {
		return "", gqlerr.Map(ctx, m.l, err, "{{.Usecase.Name.Lower}}")
	}

	return written.ID, nil
}
