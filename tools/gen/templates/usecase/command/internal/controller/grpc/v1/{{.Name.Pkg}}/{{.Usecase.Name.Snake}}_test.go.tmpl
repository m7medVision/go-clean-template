{{- $id := print .Name.Kebab "-1" -}}
package {{.Name.Pkg}}_test

import (
	"context"
	"errors"
	"log/slog"
	"net"
	"testing"
	"time"

	pb "{{.Module}}/docs/proto/v1"
	grpcmw "{{.Module}}/internal/controller/grpc/middleware"
	"{{.Module}}/internal/controller/grpc/v1/{{.Name.Pkg}}"
	"{{.Module}}/internal/entity"
	"{{.Module}}/internal/usecase/{{.Name.Pkg}}/command"
	"{{.Module}}/pkg/cqrs"
	"{{.Module}}/pkg/jwt"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
	"google.golang.org/grpc"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/credentials/insecure"
	"google.golang.org/grpc/metadata"
	"google.golang.org/grpc/status"
	"google.golang.org/grpc/test/bufconn"
)

// Test{{.Usecase.Name.Go}}RPC calls {{.Usecase.Name.Go}} on a gRPC server over bufconn whose buses hold one handler, a
// fake {{.Usecase.Name.Go}} handler, so it holds once the handler is written: it checks what the method sends
// and answers, and that the stub's entity.ErrNotImplemented answers Unimplemented.
func Test{{.Usecase.Name.Go}}RPC(t *testing.T) {
	t.Parallel()

	const bufSize = 1 << 20

	manager := jwt.New("test-secret", time.Hour)
	token, err := manager.GenerateToken("user-1", nil)
	require.NoError(t, err)

	sent := []command.{{.Usecase.Name.Go}}{{"{{"}}UserID: "user-1"{{if .Usecase.ByID}}, {{.Name.Go}}ID: "{{$id}}"{{end}}}}

	for name, tc := range map[string]struct {
		token string
		err   error
		code  codes.Code
		want  string
		sent  []command.{{.Usecase.Name.Go}}
	}{
		"answers the ID it wrote":              {token: token, want: "{{$id}}", sent: sent},
		"a stub handler answers Unimplemented": {token: token, err: entity.ErrNotImplemented, code: codes.Unimplemented, sent: sent},
		"needs the caller":                     {code: codes.Unauthenticated},
	} {
		t.Run(name, func(t *testing.T) {
			t.Parallel()

			var got []command.{{.Usecase.Name.Go}}

			b := cqrs.Buses{Commands: cqrs.NewCommands(), Queries: cqrs.NewQueries()}
			cqrs.HandleCommand(b.Commands, cqrs.HandlerFunc[command.{{.Usecase.Name.Go}}, entity.Written](
				func(_ context.Context, cmd command.{{.Usecase.Name.Go}}) (entity.Written, error) {
					got = append(got, cmd)

					return entity.Written{ID: "{{$id}}"}, tc.err
				}))

			lis := bufconn.Listen(bufSize)
			srv := grpc.NewServer(grpc.UnaryInterceptor(grpcmw.Auth(manager)))
			pb.Register{{.Usecase.Service}}Server(srv, {{.Name.Pkg}}.New(b, slog.New(slog.DiscardHandler)))

			go func() {
				if err := srv.Serve(lis); err != nil && !errors.Is(err, grpc.ErrServerStopped) {
					t.Errorf("grpc serve: %v", err)
				}
			}()

			t.Cleanup(srv.Stop)

			conn, err := grpc.NewClient("passthrough:///bufnet", grpc.WithTransportCredentials(insecure.NewCredentials()),
				grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) { return lis.DialContext(ctx) }))
			require.NoError(t, err)
			t.Cleanup(func() { _ = conn.Close() })

			ctx := metadata.AppendToOutgoingContext(t.Context(), "authorization", tc.token)
			resp, err := pb.New{{.Usecase.Service}}Client(conn).{{.Usecase.Name.Go}}(ctx, &pb.{{.Usecase.Name.Go}}Request{ {{- if .Usecase.ByID}}Id: "{{$id}}"{{end}}})

			assert.Equal(t, tc.code, status.Code(err), err)
			assert.Equal(t, tc.want, resp.GetId())
			assert.Equal(t, tc.sent, got)
		})
	}
}
