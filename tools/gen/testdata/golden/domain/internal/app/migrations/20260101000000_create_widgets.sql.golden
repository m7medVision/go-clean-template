-- The widget read model: written only by the widget projector, from the widget events. It has no
-- foreign key to users, because each projector advances on its own and the widget one can be ahead.
-- Its columns are in the order of entity.Widget's fields, so a row converts to one as it is.

-- +goose Up
CREATE TABLE "widgets" (
  "id" uuid NOT NULL,
  "user_id" uuid NOT NULL,
  "created_at" timestamptz NOT NULL DEFAULT now(),
  "updated_at" timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY ("id")
);
CREATE INDEX "idx_widgets_user_id" ON "widgets" ("user_id");

-- +goose Down
DROP TABLE "widgets";
