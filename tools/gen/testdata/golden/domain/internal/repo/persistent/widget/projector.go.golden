package widget

import (
	"context"

	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/repo/persistent/projection"
	"github.com/m7medvision/go-clean-template/internal/repo/persistent/queries"
	"github.com/m7medvision/go-clean-template/pkg/postgres"
)

// NewProjector keeps the widgets table, the widget read model, up to date from the widget events. The
// worker runs it.
func NewProjector(pg *postgres.Postgres) projection.Projector {
	return projection.NewProjector("widget", []string{"widgets"}, entity.WidgetEvents(), pg, project)
}

// project applies one event to the widgets table through q.
func project(ctx context.Context, q queries.Querier, e *entity.RecordedEvent) error {
	switch ev := e.Event.(type) {
	case entity.WidgetCreated:
		return q.InsertWidgetRow(ctx, queries.InsertWidgetRowParams{
			ID: ev.WidgetID, UserID: ev.UserID, CreatedAt: ev.At, UpdatedAt: ev.At,
		})
	case entity.WidgetUpdated:
		return q.UpdateWidgetRow(ctx, queries.UpdateWidgetRowParams{ID: ev.WidgetID, UpdatedAt: ev.At})
	case entity.WidgetDeleted:
		return q.DeleteWidgetRow(ctx, ev.WidgetID)
	default:
		return entity.ErrUnhandledEvent
	}
}
