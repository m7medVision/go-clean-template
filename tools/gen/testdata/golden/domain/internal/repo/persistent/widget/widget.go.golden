// Package widget implements the widget read model on Postgres (the widgets table), and the
// projector that writes it from the widget events.
package widget

import (
	"context"
	"errors"
	"fmt"

	"github.com/google/uuid"
	"github.com/jackc/pgx/v5"
	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/repo"
	"github.com/m7medvision/go-clean-template/internal/repo/persistent/queries"
	"github.com/m7medvision/go-clean-template/pkg/postgres"
)

// Repo reads the widgets table. Its queries join the transaction the context carries.
type Repo struct {
	pg *postgres.Postgres
}

func NewReadModel(pg *postgres.Postgres) repo.WidgetReadModel {
	return &Repo{pg: pg}
}

func (r *Repo) q(ctx context.Context) *queries.Queries {
	return queries.New(r.pg.Executor(ctx))
}

// Get reads the widget with widgetID. An ID that is not a UUID names no widget, so it is
// entity.ErrWidgetNotFound, as it is on the write side, not the error widgets.id would raise.
func (r *Repo) Get(ctx context.Context, widgetID string) (entity.Widget, error) {
	id, err := uuid.Parse(widgetID)
	if err != nil {
		return entity.Widget{}, entity.ErrWidgetNotFound
	}

	row, err := r.q(ctx).GetWidget(ctx, id.String())
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return entity.Widget{}, entity.ErrWidgetNotFound
		}

		return entity.Widget{}, fmt.Errorf("WidgetReadModel - Get - r.q(ctx).GetWidget: %w", err)
	}

	return entity.Widget(row), nil
}

func (r *Repo) List(ctx context.Context, userID string, page entity.Page) (entity.List[entity.Widget], error) {
	total, err := r.q(ctx).CountWidgets(ctx, userID)
	if err != nil {
		return entity.List[entity.Widget]{}, fmt.Errorf("WidgetReadModel - List - r.q(ctx).CountWidgets: %w", err)
	}

	rows, err := r.q(ctx).ListWidgets(ctx, queries.ListWidgetsParams{
		UserID: userID,
		Limit:  int64(page.Size()),
		Offset: int64(page.Offset),
	})
	if err != nil {
		return entity.List[entity.Widget]{}, fmt.Errorf("WidgetReadModel - List - r.q(ctx).ListWidgets: %w", err)
	}

	widgets := make([]entity.Widget, len(rows))
	for i := range rows {
		widgets[i] = entity.Widget(rows[i])
	}

	return entity.List[entity.Widget]{Items: widgets, Total: int(total)}, nil
}
