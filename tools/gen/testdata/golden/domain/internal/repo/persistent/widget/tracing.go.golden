package widget

import (
	"context"

	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/repo"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/codes"
	"go.opentelemetry.io/otel/trace"
)

const _tracerName = "github.com/m7medvision/go-clean-template/internal/repo/persistent/widget"

// tracedRepo wraps the widget read model with OpenTelemetry spans on top of the
// low-level pgx query spans, giving a semantic "WidgetReadModel.<Method>" view.
type tracedRepo struct {
	next repo.WidgetReadModel
}

func newTraced(next repo.WidgetReadModel) repo.WidgetReadModel {
	return &tracedRepo{next: next}
}

func startSpan(ctx context.Context, name string, attrs ...attribute.KeyValue) (context.Context, trace.Span) {
	return otel.Tracer(_tracerName).Start(ctx, name, trace.WithAttributes(attrs...))
}

func endSpan(span trace.Span, err error) {
	if err != nil {
		span.RecordError(err)
		span.SetStatus(codes.Error, err.Error())
	}

	span.End()
}

func (r *tracedRepo) Get(ctx context.Context, userID, widgetID string) (entity.Widget, error) {
	ctx, span := startSpan(
		ctx, "WidgetReadModel.Get",
		attribute.String("user.id", userID),
		attribute.String("widget.id", widgetID),
	)

	result, err := r.next.Get(ctx, userID, widgetID)
	endSpan(span, err)

	return result, err
}

func (r *tracedRepo) List(ctx context.Context, userID string, filter repo.WidgetFilter) ([]entity.Widget, int, error) {
	ctx, span := startSpan(
		ctx, "WidgetReadModel.List",
		attribute.String("user.id", userID),
		attribute.Int64("widget.limit", filter.Limit),
		attribute.Int64("widget.offset", filter.Offset),
	)

	page, total, err := r.next.List(ctx, userID, filter)
	endSpan(span, err)

	return page, total, err
}
