package repo

import (
	"context"

	"github.com/m7medvision/go-clean-template/internal/entity"
)

//go:generate mockgen -source=widget.go -destination=repomock/widget.go -package=repomock

// WidgetReadModel reads the widgets table, which only the widget projector writes. Get of
// one missing widget, or of an ID that is not a UUID, is entity.ErrWidgetNotFound; whether the caller
// may read it is entity.Widget's rule.
type WidgetReadModel interface {
	Get(ctx context.Context, widgetID string) (entity.Widget, error)
	// List is one page of the user's widgets, newest first.
	List(ctx context.Context, userID string, page entity.Page) (entity.List[entity.Widget], error)
}
