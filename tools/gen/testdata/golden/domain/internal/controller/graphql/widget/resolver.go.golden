// Package widget resolves the widget fields of the GraphQL schema: each field in the file named as its
// schema file is (widget.go resolves schema/widget.graphqls).
package widget

import (
	"context"
	"log/slog"

	"github.com/m7medvision/go-clean-template/internal/controller/graphql/gqlerr"
	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/query"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

type Query struct {
	qs *cqrs.Queries
	l  *slog.Logger
}

type Mutation struct {
	cmds *cqrs.Commands
	qs   *cqrs.Queries
	l    *slog.Logger
}

func New(b cqrs.Buses, l *slog.Logger) (Query, Mutation) {
	return Query{qs: b.Queries, l: l}, Mutation{cmds: b.Commands, qs: b.Queries, l: l}
}

// result reads back the widget a mutation wrote, as its answer.
func (m Mutation) result(ctx context.Context, userID, widgetID, op string) (*entity.Widget, error) {
	widget, err := cqrs.SendQuery(ctx, m.qs, query.GetWidget{UserID: userID, WidgetID: widgetID})
	if err != nil {
		return nil, gqlerr.Map(ctx, m.l, err, op)
	}

	return &widget, nil
}
