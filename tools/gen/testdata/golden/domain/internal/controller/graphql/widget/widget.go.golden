package widget

import (
	"context"

	"github.com/m7medvision/go-clean-template/internal/controller/graphql/gqlerr"
	"github.com/m7medvision/go-clean-template/internal/controller/graphql/middleware"
	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/query"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

func (q Query) Widget(ctx context.Context, id string) (*entity.Widget, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return nil, err
	}

	widget, err := cqrs.SendQuery(ctx, q.qs, query.GetWidget{UserID: caller.UserID, WidgetID: id})
	if err != nil {
		return nil, gqlerr.Map(ctx, q.l, err, "widget")
	}

	return &widget, nil
}
