package widget

import (
	"context"

	"github.com/m7medvision/go-clean-template/internal/controller/graphql/gqlerr"
	"github.com/m7medvision/go-clean-template/internal/controller/graphql/middleware"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

func (m Mutation) DeleteWidget(ctx context.Context, id string) (bool, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return false, err
	}

	_, err = cqrs.SendCommand(ctx, m.cmds, command.DeleteWidget{UserID: caller.UserID, WidgetID: id})
	if err != nil {
		return false, gqlerr.Map(ctx, m.l, err, "deleteWidget")
	}

	return true, nil
}
