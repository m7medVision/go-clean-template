package widget

import (
	"context"

	"github.com/m7medvision/go-clean-template/internal/controller/graphql/gqlerr"
	"github.com/m7medvision/go-clean-template/internal/controller/graphql/middleware"
	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// CreateWidget takes no input until the widget has fields: with the first one, give the field the
// argument input: CreateWidgetInput! and pass its fields to the command, as createTask does.
func (m Mutation) CreateWidget(ctx context.Context) (*entity.Widget, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return nil, err
	}

	written, err := cqrs.SendCommand(ctx, m.cmds, command.CreateWidget{UserID: caller.UserID})
	if err != nil {
		return nil, gqlerr.Map(ctx, m.l, err, "createWidget")
	}

	return m.result(ctx, caller.UserID, written.ID, "createWidget")
}
