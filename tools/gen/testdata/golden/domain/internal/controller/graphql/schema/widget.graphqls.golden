# The widget fields, which graphql/widget/ resolves. Add a field to Widget for each one
# entity.Widget gets. The mutations take only the ID until then, since GraphQL has no empty input
# type: with the first field, add CreateWidgetInput and UpdateWidgetInput, as task.graphqls has.

type Widget {
  id: ID!
  userId: ID!
  createdAt: Time!
  updatedAt: Time!
}

type WidgetList { widgets: [Widget!]!  total: Int! }

extend type Query {
  widget(id: ID!): Widget!
  widgets(limit: Int! = 10, offset: Int! = 0): WidgetList!
}

extend type Mutation {
  createWidget: Widget!
  updateWidget(id: ID!): Widget!
  deleteWidget(id: ID!): Boolean!
}
