package widget

import (
	"context"

	"github.com/m7medvision/go-clean-template/internal/controller/graphql/gqlerr"
	"github.com/m7medvision/go-clean-template/internal/controller/graphql/middleware"
	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// CreateWidget resolves Mutation.createWidget: it sends CreateWidget, then reads the widget back.
// It takes no input until the widget has fields: with the first one, give the field the
// argument input: CreateWidgetInput! and pass its fields to the command, as createTask does.
func (m Mutation) CreateWidget(ctx context.Context) (*entity.Widget, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return nil, err
	}

	written, err := cqrs.SendCommand[cqrs.Written](ctx, m.cmds, command.CreateWidget{UserID: caller.UserID})
	if err != nil {
		return nil, gqlerr.Map(m.l, err, "createWidget")
	}

	return m.readBack(ctx, caller.UserID, written.ID, "createWidget")
}

// UpdateWidget resolves Mutation.updateWidget: it sends UpdateWidget, then reads the widget back.
// As with CreateWidget, its input comes with the widget's first field.
func (m Mutation) UpdateWidget(ctx context.Context, id string) (*entity.Widget, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return nil, err
	}

	_, err = cqrs.SendCommand[cqrs.Written](ctx, m.cmds, command.UpdateWidget{UserID: caller.UserID, WidgetID: id})
	if err != nil {
		return nil, gqlerr.Map(m.l, err, "updateWidget")
	}

	return m.readBack(ctx, caller.UserID, id, "updateWidget")
}

// DeleteWidget resolves Mutation.deleteWidget.
func (m Mutation) DeleteWidget(ctx context.Context, id string) (bool, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return false, err
	}

	_, err = cqrs.SendCommand[cqrs.Written](ctx, m.cmds, command.DeleteWidget{UserID: caller.UserID, WidgetID: id})
	if err != nil {
		return false, gqlerr.Map(m.l, err, "deleteWidget")
	}

	return true, nil
}
