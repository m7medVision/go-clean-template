package widget_test

import (
	"context"
	"errors"
	"fmt"
	"io"
	"net"
	"testing"
	"time"

	pb "github.com/m7medvision/go-clean-template/docs/proto/v1"
	grpcmw "github.com/m7medvision/go-clean-template/internal/controller/grpc/middleware"
	grpcwidget "github.com/m7medvision/go-clean-template/internal/controller/grpc/v1/widget"
	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/query"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
	"github.com/m7medvision/go-clean-template/pkg/jwt"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
	"google.golang.org/grpc"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/credentials/insecure"
	"google.golang.org/grpc/metadata"
	"google.golang.org/grpc/status"
	"google.golang.org/grpc/test/bufconn"
	"google.golang.org/protobuf/proto"
)

const (
	_bufSize = 1 << 20
	// _owner is the user the tests sign in as, who owns the stored widget.
	_owner = "user-1"
	// _storedAt is when the stored widget was created and updated, as the service answers with it.
	_storedAt = "2026-01-02T03:04:05Z"
)

type noopLogger struct{}

func (noopLogger) Debug(any, ...any)   {}
func (noopLogger) Info(string, ...any) {}
func (noopLogger) Warn(string, ...any) {}
func (noopLogger) Error(any, ...any)   {}
func (noopLogger) Fatal(any, ...any)   {}

// stored is the widget the fake handlers answer with.
func stored() entity.Widget {
	at := time.Date(2026, time.January, 2, 3, 4, 5, 0, time.UTC)

	return entity.Widget{ID: "widget-1", UserID: _owner, CreatedAt: at, UpdatedAt: at}
}

// storedResponse is stored as the service answers with it.
func storedResponse() *pb.WidgetResponse {
	return &pb.WidgetResponse{Id: "widget-1", UserId: _owner, CreatedAt: _storedAt, UpdatedAt: _storedAt}
}

// fakeWidget answers every widget command and query: commands write stored's ID, queries read
// stored, and every one of them fails with err when it is set. It keeps every message it is sent.
type fakeWidget struct {
	stored entity.Widget
	err    error

	sent []any
}

// buses registers the fake's handlers on real buses whose one step is keep.
func (f *fakeWidget) buses() cqrs.Buses {
	cmds, qs := cqrs.NewCommands(f.keep), cqrs.NewQueries(f.keep)
	write := func(context.Context) (cqrs.Written, error) { return cqrs.Written{ID: f.stored.ID}, f.err }

	cqrs.HandleCommand(cmds, cqrs.HandlerFunc[command.CreateWidget, cqrs.Written](
		func(ctx context.Context, _ command.CreateWidget) (cqrs.Written, error) { return write(ctx) }))
	cqrs.HandleCommand(cmds, cqrs.HandlerFunc[command.UpdateWidget, cqrs.Written](
		func(ctx context.Context, _ command.UpdateWidget) (cqrs.Written, error) { return write(ctx) }))
	cqrs.HandleCommand(cmds, cqrs.HandlerFunc[command.DeleteWidget, cqrs.Written](
		func(ctx context.Context, _ command.DeleteWidget) (cqrs.Written, error) { return write(ctx) }))

	cqrs.HandleQuery(qs, cqrs.HandlerFunc[query.GetWidget, entity.Widget](
		func(context.Context, query.GetWidget) (entity.Widget, error) { return f.stored, f.err }))
	cqrs.HandleQuery(qs, cqrs.HandlerFunc[query.ListWidgets, query.WidgetPage](
		func(context.Context, query.ListWidgets) (query.WidgetPage, error) {
			return query.WidgetPage{Widgets: []entity.Widget{f.stored}, Total: 1}, f.err
		}))

	return cqrs.Buses{Commands: cmds, Queries: qs}
}

// keep is a step that keeps every message the buses carry, in the order they are sent.
func (f *fakeWidget) keep(ctx context.Context, msg cqrs.Message, next cqrs.Next) (any, error) {
	f.sent = append(f.sent, msg.Body)

	return next(ctx)
}

// dial serves the widget service over f's buses, behind the auth interceptor, on an in-memory
// listener.
func dial(t *testing.T, f *fakeWidget) (pb.WidgetServiceClient, *jwt.Manager) {
	t.Helper()

	manager := jwt.New("test-secret", time.Hour)
	lis := bufconn.Listen(_bufSize)
	srv := grpc.NewServer(grpc.UnaryInterceptor(grpcmw.AuthInterceptor(manager)))
	pb.RegisterWidgetServiceServer(srv, grpcwidget.New(f.buses(), noopLogger{}))

	go func() {
		if err := srv.Serve(lis); err != nil && !errors.Is(err, grpc.ErrServerStopped) {
			t.Errorf("grpc serve: %v", err)
		}
	}()

	t.Cleanup(srv.Stop)

	conn, err := grpc.NewClient("passthrough:///bufnet",
		grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) { return lis.DialContext(ctx) }),
		grpc.WithTransportCredentials(insecure.NewCredentials()),
	)
	require.NoError(t, err)
	t.Cleanup(func() { _ = conn.Close() })

	return pb.NewWidgetServiceClient(conn), manager
}

// signedIn is a context whose calls carry _owner's token.
func signedIn(t *testing.T, manager *jwt.Manager) context.Context {
	t.Helper()

	token, err := manager.GenerateToken(_owner, nil)
	require.NoError(t, err)

	return metadata.AppendToOutgoingContext(t.Context(), "authorization", token)
}

// call is one call to one widget RPC, with what it answers when the fake handlers succeed and the
// commands and queries it sends them.
type call struct {
	do   func(ctx context.Context, client pb.WidgetServiceClient) (proto.Message, error)
	want proto.Message
	sent []any
}

// calls are one call to each widget RPC.
func calls() map[string]call {
	get := query.GetWidget{UserID: _owner, WidgetID: "widget-1"}

	return map[string]call{
		"create": {
			do: func(ctx context.Context, client pb.WidgetServiceClient) (proto.Message, error) {
				return client.CreateWidget(ctx, &pb.CreateWidgetRequest{})
			},
			want: storedResponse(),
			sent: []any{command.CreateWidget{UserID: _owner}, get},
		},
		"get": {
			do: func(ctx context.Context, client pb.WidgetServiceClient) (proto.Message, error) {
				return client.GetWidget(ctx, &pb.GetWidgetRequest{Id: "widget-1"})
			},
			want: storedResponse(),
			sent: []any{get},
		},
		"list": {
			do: func(ctx context.Context, client pb.WidgetServiceClient) (proto.Message, error) {
				return client.ListWidgets(ctx, &pb.ListWidgetsRequest{Limit: 5, Offset: 10})
			},
			want: &pb.ListWidgetsResponse{Widgets: []*pb.WidgetResponse{storedResponse()}, Total: 1},
			sent: []any{query.ListWidgets{UserID: _owner, Limit: 5, Offset: 10}},
		},
		"update": {
			do: func(ctx context.Context, client pb.WidgetServiceClient) (proto.Message, error) {
				return client.UpdateWidget(ctx, &pb.UpdateWidgetRequest{Id: "widget-1"})
			},
			want: storedResponse(),
			sent: []any{command.UpdateWidget{UserID: _owner, WidgetID: "widget-1"}, get},
		},
		"delete": {
			do: func(ctx context.Context, client pb.WidgetServiceClient) (proto.Message, error) {
				return client.DeleteWidget(ctx, &pb.DeleteWidgetRequest{Id: "widget-1"})
			},
			want: &pb.DeleteWidgetResponse{},
			sent: []any{command.DeleteWidget{UserID: _owner, WidgetID: "widget-1"}},
		},
	}
}

func TestEachWidgetRPCDecodesTheRequestAndEncodesTheAnswer(t *testing.T) {
	t.Parallel()

	for name, c := range calls() {
		t.Run(name, func(t *testing.T) {
			t.Parallel()

			fake := &fakeWidget{stored: stored()}
			client, manager := dial(t, fake)

			got, err := c.do(signedIn(t, manager), client)

			require.NoError(t, err)
			assert.True(t, proto.Equal(c.want, got), "got %v, want %v", got, c.want)
			assert.Equal(t, c.sent, fake.sent)
		})
	}
}

func TestEachWidgetRPCNeedsTheCaller(t *testing.T) {
	t.Parallel()

	for name, c := range calls() {
		t.Run(name, func(t *testing.T) {
			t.Parallel()

			fake := &fakeWidget{stored: stored()}
			client, _ := dial(t, fake)

			_, err := c.do(t.Context(), client)

			assert.Equal(t, codes.Unauthenticated, status.Code(err))
			assert.Empty(t, fake.sent, "nothing is sent without a caller")
		})
	}
}

// Every RPC maps what a handler fails with the same way: first the failures any command can
// produce, then the widget errors, then anything else. Until the handlers are written, every RPC
// answers Unimplemented.
func TestEachWidgetRPCMapsEachFailure(t *testing.T) {
	t.Parallel()

	for failure, tc := range map[string]struct {
		err  error
		code codes.Code
	}{
		"a stub handler":      {entity.ErrNotImplemented, codes.Unimplemented},
		"a read model behind": {entity.ErrReadModelBehind, codes.Unavailable},
		"a concurrent change": {entity.ErrConcurrencyConflict, codes.Aborted},
		"another user's":      {entity.ErrWidgetForbidden, codes.PermissionDenied},
		"none with the ID":    {entity.ErrWidgetNotFound, codes.NotFound},
		"anything else":       {io.ErrUnexpectedEOF, codes.Internal},
	} {
		for name, c := range calls() {
			t.Run(name+"/"+failure, func(t *testing.T) {
				t.Parallel()

				fake := &fakeWidget{stored: stored(), err: fmt.Errorf("handler: %w", tc.err)}
				client, manager := dial(t, fake)

				_, err := c.do(signedIn(t, manager), client)

				assert.Equal(t, tc.code, status.Code(err), err)
			})
		}
	}
}

func TestListWidgetsRefusesANegativePage(t *testing.T) {
	t.Parallel()

	for name, req := range map[string]*pb.ListWidgetsRequest{
		"limit":  {Limit: -1},
		"offset": {Offset: -1},
	} {
		t.Run(name, func(t *testing.T) {
			t.Parallel()

			fake := &fakeWidget{stored: stored()}
			client, manager := dial(t, fake)

			_, err := client.ListWidgets(signedIn(t, manager), req)

			assert.Equal(t, codes.InvalidArgument, status.Code(err))
			assert.Empty(t, fake.sent, "nothing is sent for a page that is not one")
		})
	}
}
