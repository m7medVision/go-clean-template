package widget

import (
	"context"

	v1 "github.com/m7medvision/go-clean-template/docs/proto/v1"
	"github.com/m7medvision/go-clean-template/internal/controller/authn"
	"github.com/m7medvision/go-clean-template/internal/controller/grpc/v1/rpcerr"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// UpdateWidget sends UpdateWidget, then reads the widget back. As in CreateWidget, the fields
// of the request go into the command once they are added.
func (c *Controller) UpdateWidget(ctx context.Context, req *v1.UpdateWidgetRequest) (*v1.WidgetResponse, error) {
	userID := authn.MustCaller(ctx).UserID

	_, err := cqrs.SendCommand(ctx, c.cmds, command.UpdateWidget{UserID: userID, WidgetID: req.GetId()})
	if err != nil {
		return nil, rpcerr.Status(ctx, c.l, err, "UpdateWidget")
	}

	resp, err := c.readBack(ctx, userID, req.GetId())
	if err != nil {
		return nil, rpcerr.Status(ctx, c.l, err, "UpdateWidget")
	}

	return resp, nil
}
