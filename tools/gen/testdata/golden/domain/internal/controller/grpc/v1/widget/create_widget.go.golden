package widget

import (
	"context"

	v1 "github.com/m7medvision/go-clean-template/docs/proto/v1"
	"github.com/m7medvision/go-clean-template/internal/controller/authn"
	"github.com/m7medvision/go-clean-template/internal/controller/grpc/v1/rpcerr"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// CreateWidget sends CreateWidget, then reads the widget back. The fields of the request go
// into the command once they are added: name the request to read them.
func (c *Controller) CreateWidget(ctx context.Context, _ *v1.CreateWidgetRequest) (*v1.WidgetResponse, error) {
	userID := authn.MustCaller(ctx).UserID

	written, err := cqrs.SendCommand(ctx, c.cmds, command.CreateWidget{UserID: userID})
	if err != nil {
		return nil, rpcerr.Status(ctx, c.l, err, "CreateWidget")
	}

	resp, err := c.readBack(ctx, userID, written.ID)
	if err != nil {
		return nil, rpcerr.Status(ctx, c.l, err, "CreateWidget")
	}

	return resp, nil
}
