package widget

import (
	v1 "github.com/m7medvision/go-clean-template/docs/proto/v1"
	"github.com/m7medvision/go-clean-template/internal/controller/grpc/v1/response"
	"github.com/m7medvision/go-clean-template/internal/entity"
)

func NewWidgetResponse(widget *entity.Widget) *v1.WidgetResponse {
	return &v1.WidgetResponse{
		Id:        widget.ID,
		UserId:    widget.UserID,
		CreatedAt: response.Time(widget.CreatedAt),
		UpdatedAt: response.Time(widget.UpdatedAt),
	}
}

func NewListWidgetsResponse(widgets []entity.Widget, total int) *v1.ListWidgetsResponse {
	pbWidgets := make([]*v1.WidgetResponse, len(widgets))
	for i := range widgets {
		pbWidgets[i] = NewWidgetResponse(&widgets[i])
	}

	return &v1.ListWidgetsResponse{
		Widgets: pbWidgets,
		Total:   response.Count(total),
	}
}
