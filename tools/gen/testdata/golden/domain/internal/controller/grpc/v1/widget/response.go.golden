package widget

import (
	"math"

	v1 "github.com/m7medvision/go-clean-template/docs/proto/v1"
	"github.com/m7medvision/go-clean-template/internal/entity"
)

// NewWidgetResponse -.
func NewWidgetResponse(row *entity.Widget) *v1.WidgetResponse {
	return &v1.WidgetResponse{
		Id:        row.ID,
		UserId:    row.UserID,
		CreatedAt: row.CreatedAt.Format("2006-01-02T15:04:05Z"),
		UpdatedAt: row.UpdatedAt.Format("2006-01-02T15:04:05Z"),
	}
}

// NewListWidgetsResponse -.
func NewListWidgetsResponse(rows []entity.Widget, total int) *v1.ListWidgetsResponse {
	msgs := make([]*v1.WidgetResponse, len(rows))
	for i := range rows {
		msgs[i] = NewWidgetResponse(&rows[i])
	}

	if total > math.MaxInt32 {
		total = math.MaxInt32
	}

	return &v1.ListWidgetsResponse{
		Widgets: msgs,
		Total:   int32(total),
	}
}
