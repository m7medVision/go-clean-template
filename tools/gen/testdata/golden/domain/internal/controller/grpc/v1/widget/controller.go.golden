// Package widget serves WidgetService (docs/proto/v1/widget.proto) over gRPC.
package widget

import (
	"context"
	"log/slog"

	v1 "github.com/m7medvision/go-clean-template/docs/proto/v1"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/query"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

type Controller struct {
	v1.UnimplementedWidgetServiceServer

	cmds *cqrs.Commands
	qs   *cqrs.Queries
	l    *slog.Logger
}

func New(b cqrs.Buses, l *slog.Logger) v1.WidgetServiceServer {
	return &Controller{cmds: b.Commands, qs: b.Queries, l: l}
}

func (c *Controller) readBack(ctx context.Context, userID, widgetID string) (*v1.WidgetResponse, error) {
	widget, err := cqrs.SendQuery(ctx, c.qs, query.GetWidget{UserID: userID, WidgetID: widgetID})
	if err != nil {
		return nil, err
	}

	return NewWidgetResponse(&widget), nil
}
