package widget

import (
	"context"
	"net/http"

	"github.com/danielgtaylor/huma/v2"
	"github.com/m7medvision/go-clean-template/internal/controller/authn"
	"github.com/m7medvision/go-clean-template/internal/controller/restapi/v1/apidoc"
	"github.com/m7medvision/go-clean-template/internal/controller/restapi/v1/apierr"
)

func (r *controller) getWidget(api huma.API) {
	huma.Register(api, huma.Operation{
		OperationID: "get-widget",
		Summary:     "Get widget",
		Description: "Get one of the current user's widgets by ID",
		Method:      http.MethodGet,
		Path:        "/v1/widgets/{id}",
		Tags:        []string{_tag},
		Security:    []map[string][]string{{apidoc.BearerAuthScheme: {}}},
		Errors: apierr.QueryErrors(
			http.StatusUnauthorized, http.StatusForbidden, http.StatusNotFound, http.StatusNotImplemented,
		),
	}, func(ctx context.Context, input *widgetPathInput) (*widgetOutput, error) {
		userID := authn.MustCaller(ctx).UserID

		widget, err := r.readBack(ctx, userID, input.ID)
		if err != nil {
			return nil, apierr.Problem(ctx, r.l, err, "getWidget")
		}

		return &widgetOutput{Body: widget}, nil
	})
}
