// Package widget serves the v1 widget operations over REST.
package widget

import (
	"context"
	"log/slog"

	"github.com/danielgtaylor/huma/v2"
	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/query"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

const _tag = "widgets"

type controller struct {
	cmds *cqrs.Commands
	qs   *cqrs.Queries
	l    *slog.Logger
}

// NewRoutes registers the widget operations. Until its handler is written, each answers 501, which
// its Errors list: drop http.StatusNotImplemented from them once it no longer can.
func NewRoutes(api huma.API, b cqrs.Buses, l *slog.Logger) {
	r := &controller{cmds: b.Commands, qs: b.Queries, l: l}

	r.createWidget(api)
	r.listWidgets(api)
	r.getWidget(api)
	r.updateWidget(api)
	r.deleteWidget(api)
}

func (r *controller) readBack(ctx context.Context, userID, widgetID string) (entity.Widget, error) {
	return cqrs.SendQuery(ctx, r.qs, query.GetWidget{UserID: userID, WidgetID: widgetID})
}
