package widget_test

import (
	"context"
	"net/http"

	"github.com/m7medvision/go-clean-template/config"
	"github.com/m7medvision/go-clean-template/internal/controller/restapi/resttest"
	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/query"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// fakeWidget answers every widget command and query: commands write stored's ID, queries read
// stored, and every one of them fails with err when it is set. It keeps every message it is sent.
type fakeWidget struct {
	stored entity.Widget
	err    error

	sent []any
}

// buses registers the fake's handlers on real buses whose one step is keep.
func (f *fakeWidget) buses() cqrs.Buses {
	cmds, qs := cqrs.NewCommands(f.keep), cqrs.NewQueries(f.keep)
	write := func(context.Context) (cqrs.Written, error) { return cqrs.Written{ID: f.stored.ID}, f.err }

	cqrs.HandleCommand(cmds, cqrs.HandlerFunc[command.CreateWidget, cqrs.Written](
		func(ctx context.Context, _ command.CreateWidget) (cqrs.Written, error) { return write(ctx) }))
	cqrs.HandleCommand(cmds, cqrs.HandlerFunc[command.UpdateWidget, cqrs.Written](
		func(ctx context.Context, _ command.UpdateWidget) (cqrs.Written, error) { return write(ctx) }))
	cqrs.HandleCommand(cmds, cqrs.HandlerFunc[command.DeleteWidget, cqrs.Written](
		func(ctx context.Context, _ command.DeleteWidget) (cqrs.Written, error) { return write(ctx) }))

	cqrs.HandleQuery(qs, cqrs.HandlerFunc[query.GetWidget, entity.Widget](
		func(context.Context, query.GetWidget) (entity.Widget, error) { return f.stored, f.err }))
	cqrs.HandleQuery(qs, cqrs.HandlerFunc[query.ListWidgets, query.WidgetPage](
		func(context.Context, query.ListWidgets) (query.WidgetPage, error) {
			return query.WidgetPage{Widgets: []entity.Widget{f.stored}, Total: 1}, f.err
		}))

	return cqrs.Buses{Commands: cmds, Queries: qs}
}

// keep is a step that keeps every message the buses carry, in the order they are sent.
func (f *fakeWidget) keep(ctx context.Context, msg cqrs.Message, next cqrs.Next) (any, error) {
	f.sent = append(f.sent, msg.Body)

	return next(ctx)
}

// newRouter serves the REST router over f's buses.
func newRouter(cfg *config.Config, f *fakeWidget) http.Handler {
	return resttest.NewRouter(cfg, f.buses())
}
