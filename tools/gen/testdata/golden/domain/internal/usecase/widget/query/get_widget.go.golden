// Package query holds the widget domain's queries, one file each, with their handlers. They read
// only the widget read model.
package query

import (
	"context"
	"fmt"

	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/repo"
)

// GetWidget reads UserID's widget: entity.ErrWidgetNotFound when there is none,
// entity.ErrWidgetForbidden when it is another user's.
type GetWidget struct {
	UserID   string
	WidgetID string
}

// QueryName -.
func (GetWidget) QueryName() string { return "GetWidget" }

// GetWidgetHandler handles GetWidget.
type GetWidgetHandler struct {
	Widgets repo.WidgetReadModel
}

// Handle is a stub: write it to read the widget with h.Widgets.Get.
func (GetWidgetHandler) Handle(_ context.Context, _ GetWidget) (entity.Widget, error) {
	return entity.Widget{}, fmt.Errorf("GetWidget: %w", entity.ErrNotImplemented)
}
