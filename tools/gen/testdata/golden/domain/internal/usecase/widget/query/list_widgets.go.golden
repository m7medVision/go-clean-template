package query

import (
	"context"
	"fmt"

	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/repo"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// ListWidgets lists one page of UserID's widgets, newest first. Its Page's Validate refuses
// a page out of bounds; what a list filters by goes here too.
type ListWidgets struct {
	cqrs.Query[entity.List[entity.Widget]]
	entity.Page

	UserID string
}

type ListWidgetsHandler struct {
	Widgets repo.WidgetReadModel
}

// Handle is a stub: write it to read the page with h.Widgets.List.
func (ListWidgetsHandler) Handle(_ context.Context, _ ListWidgets) (entity.List[entity.Widget], error) {
	return entity.List[entity.Widget]{}, fmt.Errorf("ListWidgets: %w", entity.ErrNotImplemented)
}
