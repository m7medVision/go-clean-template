package command_test

import (
	"context"
	"testing"
	"time"

	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/repo/memstore"
	"github.com/m7medvision/go-clean-template/internal/usecase/aggregate"
	"github.com/stretchr/testify/require"
)

const (
	_owner    = "user-1"
	_widgetID = "widget-1"
)

// The update and delete handlers change the widget through aggregate.Change: this stops compiling
// when the aggregate no longer fits it.
var _ = aggregate.Change[entity.WidgetAggregate]

// givenWidget is a store holding _owner's widget, for the commands that change one.
func givenWidget(t *testing.T) *memstore.Store {
	t.Helper()

	store := memstore.New(entity.EventTypes())
	_, err := store.Save(context.Background(), entity.NewWidgetAggregate(_widgetID, _owner, time.Now()))
	require.NoError(t, err)

	return store
}
