package command_test

import (
	"context"
	"testing"
	"time"

	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/repo/memstore"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

const (
	_owner    = "user-1"
	_widgetID = "widget-1"
)

// givenWidget is a store holding _owner's widget, for the commands that change one.
func givenWidget(t *testing.T) *memstore.Store {
	t.Helper()

	store := memstore.New(entity.EventTypes())
	_, err := store.Save(context.Background(), entity.NewWidgetAggregate(_widgetID, _owner, time.Now()))
	require.NoError(t, err)

	return store
}

func TestTheWidgetCommandsActForTheirUser(t *testing.T) {
	t.Parallel()

	for name, cmd := range map[string]interface {
		CommandName() string
		ActorID() string
	}{
		"CreateWidget": command.CreateWidget{UserID: _owner},
		"UpdateWidget": command.UpdateWidget{UserID: _owner, WidgetID: _widgetID},
		"DeleteWidget": command.DeleteWidget{UserID: _owner, WidgetID: _widgetID},
	} {
		assert.Equal(t, name, cmd.CommandName())
		assert.Equal(t, _owner, cmd.ActorID(), name)
	}
}
