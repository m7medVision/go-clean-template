// Package command holds the widget domain's commands, one file each, with their handlers.
package command

import (
	"context"
	"fmt"
	"time"

	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/repo"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// CreateWidget creates one widget owned by UserID. The fields it is created with go here, and the
// rules they follow in Validate.
type CreateWidget struct {
	cqrs.Command[entity.Written]

	UserID string
}

func (c CreateWidget) ActorID() string { return c.UserID }

// CreateWidgetHandler's Now is the clock (time.Now when nil).
type CreateWidgetHandler struct {
	Store repo.EventStore
	Now   func() time.Time
}

// Handle is a stub: write it to save entity.NewWidgetAggregate through aggregate.Save.
func (CreateWidgetHandler) Handle(_ context.Context, _ CreateWidget) (entity.Written, error) {
	return entity.Written{}, fmt.Errorf("CreateWidget: %w", entity.ErrNotImplemented)
}
