// Package command holds the widget domain's commands, one file each, with their handlers.
package command

import (
	"context"
	"fmt"

	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/repo"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// CreateWidget creates one widget owned by UserID. The fields it is created with go here.
type CreateWidget struct {
	UserID string
}

// CommandName -.
func (CreateWidget) CommandName() string { return "CreateWidget" }

// ActorID -.
func (c CreateWidget) ActorID() string { return c.UserID }

// CreateWidgetHandler handles CreateWidget.
type CreateWidgetHandler struct {
	Store repo.EventStore
}

// Handle is a stub: write it to save entity.NewWidgetAggregate through aggregate.Create.
func (CreateWidgetHandler) Handle(_ context.Context, _ CreateWidget) (cqrs.Written, error) {
	return cqrs.Written{}, fmt.Errorf("CreateWidget: %w", entity.ErrNotImplemented)
}
