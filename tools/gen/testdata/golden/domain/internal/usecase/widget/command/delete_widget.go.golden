package command

import (
	"context"
	"fmt"

	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/repo"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// DeleteWidget deletes UserID's widget. Another user's widget is entity.ErrWidgetNotFound.
type DeleteWidget struct {
	UserID   string
	WidgetID string
}

// CommandName -.
func (DeleteWidget) CommandName() string { return "DeleteWidget" }

// ActorID -.
func (c DeleteWidget) ActorID() string { return c.UserID }

// DeleteWidgetHandler handles DeleteWidget.
type DeleteWidgetHandler struct {
	Store repo.EventStore
}

// Handle is a stub: write it to load the widget through aggregate.Change and call its Delete.
func (DeleteWidgetHandler) Handle(_ context.Context, _ DeleteWidget) (cqrs.Written, error) {
	return cqrs.Written{}, fmt.Errorf("DeleteWidget: %w", entity.ErrNotImplemented)
}
