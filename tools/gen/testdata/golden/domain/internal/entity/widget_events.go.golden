package entity

import "time"

// WidgetCreated is one widget's first event.
type WidgetCreated struct {
	WidgetID string    `json:"widget_id"`
	UserID   string    `json:"user_id"`
	At       time.Time `json:"at"`
}

// WidgetUpdated changes one widget. For now it carries only the time: add what an update sets.
type WidgetUpdated struct {
	WidgetID string    `json:"widget_id"`
	At       time.Time `json:"at"`
}

// WidgetDeleted ends one widget: its stream stays, and loads as not found.
type WidgetDeleted struct {
	WidgetID string    `json:"widget_id"`
	At       time.Time `json:"at"`
}

func (WidgetCreated) EventType() string { return "WidgetCreated" }

// SchemaVersion is the version of the event's shape, raised with an upcast when it changes.
func (WidgetCreated) SchemaVersion() int { return 1 }

func (WidgetUpdated) EventType() string { return "WidgetUpdated" }

func (WidgetUpdated) SchemaVersion() int { return 1 }

func (WidgetDeleted) EventType() string { return "WidgetDeleted" }

func (WidgetDeleted) SchemaVersion() int { return 1 }

// WidgetEvents lists the widget events, one zero value each.
func WidgetEvents() []Event {
	return []Event{WidgetCreated{}, WidgetUpdated{}, WidgetDeleted{}}
}
