  + 
  + // CountWidgets resolves Query.countWidgets: it sends CountWidgets and answers with its result, whose
  + // placeholder field stays null. Once query.CountWidgetsResult has fields, give CountWidgetsResult in
  + // the schema the same, and set them from the result here.
  + func (q Query) CountWidgets(ctx context.Context) (*model.CountWidgetsResult, error) {
  + 	caller, err := middleware.Caller(ctx)
  + 	if err != nil {
  + 		return nil, err
  + 	}
  + 
  + 	_, err = cqrs.SendQuery[query.CountWidgetsResult](ctx, q.qs, query.CountWidgets{UserID: caller.UserID})
  + 	if err != nil {
  + 		return nil, gqlerr.Map(q.l, err, "countWidgets")
  + 	}
  + 
  + 	return &model.CountWidgetsResult{}, nil
  + }

