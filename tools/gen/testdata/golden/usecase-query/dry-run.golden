  + // countWidgets sends CountWidgets and answers with its result. The fields of the query come
  + // from the request once they are added: put them in countWidgetsInput, as parameters.
  + func (r *controller) countWidgets(api huma.API) {
  + 	huma.Register(api, huma.Operation{
  + 		OperationID: "count-widgets",
  + 		Summary:     "Count widgets",
  + 		Description: "Count widgets for the current user",
  + 		Method:      http.MethodGet,
  + 		Path:        "/v1/widgets/count",
  + 		Tags:        []string{_widgetsTag},
  + 		Security:    []map[string][]string{{apidoc.BearerAuthScheme: {}}},
  + 		Errors:      []int{http.StatusUnauthorized, http.StatusInternalServerError, http.StatusNotImplemented},
  + 	}, func(ctx context.Context, _ *countWidgetsInput) (*countWidgetsOutput, error) {
  + 		userID, ok := middleware.UserID(ctx)
  + 		if !ok {
  + 			return nil, huma.Error401Unauthorized("unauthorized")
  + 		}
  + 
  + 		result, err := cqrs.SendQuery[query.CountWidgetsResult](ctx, r.qs, query.CountWidgets{UserID: userID})
  + 		if err != nil {
  + 			return nil, r.problem(err, "countWidgets")
  + 		}
  + 
  + 		return &countWidgetsOutput{Body: result}, nil
  + 	})
  + }

