  + // TestCountWidgetsOperation sends count-widgets through real buses whose one handler is a
  + // fake CountWidgets handler, so it holds once the handler is written: it checks what the operation
  + // sends and answers, and that the stub's entity.ErrNotImplemented answers 501.
  + func TestCountWidgetsOperation(t *testing.T) {
  + 	t.Parallel()
  + 
  + 	token := resttest.Token(t)
  + 	sent := []query.CountWidgets{{UserID: "user-1"}}
  + 
  + 	for name, tc := range map[string]struct {
  + 		token  string
  + 		err    error
  + 		status int
  + 		want   string
  + 		sent   []query.CountWidgets
  + 	}{
  + 		"answers the result":         {token: token, status: http.StatusOK, want: `{}`, sent: sent},
  + 		"a stub handler answers 501": {token: token, err: entity.ErrNotImplemented, status: http.StatusNotImplemented, sent: sent},
  + 		"needs the caller":           {status: http.StatusUnauthorized},
  + 	} {
  + 		t.Run(name, func(t *testing.T) {
  + 			t.Parallel()
  + 
  + 			var got []query.CountWidgets
