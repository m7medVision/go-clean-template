package widget

import (
	"context"

	v1 "github.com/m7medvision/go-clean-template/docs/proto/v1"
	"github.com/m7medvision/go-clean-template/internal/controller/authn"
	"github.com/m7medvision/go-clean-template/internal/controller/grpc/v1/rpcerr"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/query"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// CountWidgets sends CountWidgets and answers with its result. The fields of
// query.CountWidgetsResult go into CountWidgetsResponse: set them from the result here. Those of
// the query come from the request once they are added: put them in CountWidgetsRequest, and
// name the request to read them.
func (c *Controller) CountWidgets(ctx context.Context, _ *v1.CountWidgetsRequest) (*v1.CountWidgetsResponse, error) {
	userID := authn.MustCaller(ctx).UserID

	_, err := cqrs.SendQuery(ctx, c.qs, query.CountWidgets{UserID: userID})
	if err != nil {
		return nil, rpcerr.Status(ctx, c.l, err, "CountWidgets")
	}

	return &v1.CountWidgetsResponse{}, nil
}
