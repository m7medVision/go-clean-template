package widget

import (
	"context"

	"github.com/m7medvision/go-clean-template/internal/controller/graphql/gqlerr"
	"github.com/m7medvision/go-clean-template/internal/controller/graphql/middleware"
	"github.com/m7medvision/go-clean-template/internal/controller/graphql/model"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/query"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// CountWidgets answers its result, whose placeholder field stays null. Once
// query.CountWidgetsResult has fields, give CountWidgetsResult in the schema the same, and set them
// from the result here.
func (q Query) CountWidgets(ctx context.Context) (*model.CountWidgetsResult, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return nil, err
	}

	_, err = cqrs.SendQuery(ctx, q.qs, query.CountWidgets{UserID: caller.UserID})
	if err != nil {
		return nil, gqlerr.Map(ctx, q.l, err, "countWidgets")
	}

	return &model.CountWidgetsResult{}, nil
}
