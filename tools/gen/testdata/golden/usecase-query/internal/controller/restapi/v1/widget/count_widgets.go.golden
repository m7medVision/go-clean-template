package widget

import (
	"context"
	"net/http"

	"github.com/danielgtaylor/huma/v2"
	"github.com/m7medvision/go-clean-template/internal/controller/authn"
	"github.com/m7medvision/go-clean-template/internal/controller/restapi/v1/apidoc"
	"github.com/m7medvision/go-clean-template/internal/controller/restapi/v1/apierr"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/query"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

type countWidgetsInput struct{}

type countWidgetsOutput struct {
	Body query.CountWidgetsResult
}

// countWidgets sends CountWidgets and answers with its result. The fields of the query come
// from the request once they are added: put them in countWidgetsInput, as parameters. Its
// handler answers 501 until it is written: then drop http.StatusNotImplemented.
func (r *controller) countWidgets(api huma.API) {
	huma.Register(api, huma.Operation{
		OperationID: "count-widgets",
		Summary:     "Count widgets",
		Description: "Count widgets for the current user",
		Method:      http.MethodGet,
		Path:        "/v1/widgets/count",
		Tags:        []string{_tag},
		Security:    []map[string][]string{{apidoc.BearerAuthScheme: {}}},
		Errors:      apierr.QueryErrors(http.StatusUnauthorized, http.StatusNotImplemented),
	}, func(ctx context.Context, _ *countWidgetsInput) (*countWidgetsOutput, error) {
		userID := authn.MustCaller(ctx).UserID

		result, err := cqrs.SendQuery(ctx, r.qs, query.CountWidgets{UserID: userID})
		if err != nil {
			return nil, apierr.Problem(ctx, r.l, err, "countWidgets")
		}

		return &countWidgetsOutput{Body: result}, nil
	})
}
