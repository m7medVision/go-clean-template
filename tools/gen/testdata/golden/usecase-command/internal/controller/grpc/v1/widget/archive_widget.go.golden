package widget

import (
	"context"

	v1 "github.com/m7medvision/go-clean-template/docs/proto/v1"
	"github.com/m7medvision/go-clean-template/internal/controller/authn"
	"github.com/m7medvision/go-clean-template/internal/controller/grpc/v1/rpcerr"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// ArchiveWidget sends ArchiveWidget and answers with the ID it wrote. The fields of the command
// come from the request once they are added: put them in ArchiveWidgetRequest.
func (c *Controller) ArchiveWidget(ctx context.Context, req *v1.ArchiveWidgetRequest) (*v1.ArchiveWidgetResponse, error) {
	userID := authn.MustCaller(ctx).UserID

	written, err := cqrs.SendCommand(ctx, c.cmds, command.ArchiveWidget{UserID: userID, WidgetID: req.GetId()})
	if err != nil {
		return nil, rpcerr.Status(ctx, c.l, err, "ArchiveWidget")
	}

	return &v1.ArchiveWidgetResponse{Id: written.ID}, nil
}
