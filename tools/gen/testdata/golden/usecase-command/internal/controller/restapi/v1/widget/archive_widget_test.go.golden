package widget_test

import (
	"context"
	"net/http"
	"testing"

	"github.com/m7medvision/go-clean-template/internal/controller/restapi/resttest"
	"github.com/m7medvision/go-clean-template/internal/controller/restapi/v1/widget"
	"github.com/m7medvision/go-clean-template/internal/entity"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// TestArchiveWidgetOperation sends archive-widget through real buses whose one handler is a
// fake ArchiveWidget handler, so it holds once the handler is written: it checks what the operation
// sends and answers, and that the stub's entity.ErrNotImplemented answers 501.
func TestArchiveWidgetOperation(t *testing.T) {
	t.Parallel()

	token := resttest.Token(t)
	sent := []command.ArchiveWidget{{UserID: "user-1", WidgetID: "widget-1"}}

	for name, tc := range map[string]struct {
		token  string
		err    error
		status int
		want   string
		sent   []command.ArchiveWidget
	}{
		"answers the ID it wrote":    {token: token, status: http.StatusOK, want: `{"id":"widget-1"}`, sent: sent},
		"a stub handler answers 501": {token: token, err: entity.ErrNotImplemented, status: http.StatusNotImplemented, sent: sent},
		"needs the caller":           {status: http.StatusUnauthorized},
	} {
		t.Run(name, func(t *testing.T) {
			t.Parallel()

			var got []command.ArchiveWidget

			b := resttest.NewBuses()
			cqrs.HandleCommand(b.Commands, cqrs.HandlerFunc[command.ArchiveWidget, entity.Written](
				func(_ context.Context, cmd command.ArchiveWidget) (entity.Written, error) {
					got = append(got, cmd)

					return entity.Written{ID: "widget-1"}, tc.err
				}))

			resp := resttest.Do(t.Context(), resttest.NewRouter(b, widget.NewRoutes), http.MethodPost, "/v1/widgets/widget-1/archive", tc.token, "")

			require.Equal(t, tc.status, resp.Code, resp.Body.String())
			assert.Equal(t, tc.sent, got)

			if tc.want != "" {
				assert.JSONEq(t, tc.want, resp.Body.String())
			}
		})
	}
}
