package widget

import (
	"context"

	"github.com/m7medvision/go-clean-template/internal/controller/graphql/gqlerr"
	"github.com/m7medvision/go-clean-template/internal/controller/graphql/middleware"
	"github.com/m7medvision/go-clean-template/internal/usecase/widget/command"
	"github.com/m7medvision/go-clean-template/pkg/cqrs"
)

// ArchiveWidget answers the ID it wrote. The fields of the command come from the field's arguments
// once they are added.
func (m Mutation) ArchiveWidget(ctx context.Context, id string) (string, error) {
	caller, err := middleware.Caller(ctx)
	if err != nil {
		return "", err
	}

	written, err := cqrs.SendCommand(ctx, m.cmds, command.ArchiveWidget{UserID: caller.UserID, WidgetID: id})
	if err != nil {
		return "", gqlerr.Map(ctx, m.l, err, "archiveWidget")
	}

	return written.ID, nil
}
