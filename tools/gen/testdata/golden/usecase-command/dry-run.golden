  + // ArchiveWidget sends ArchiveWidget and answers with the ID it wrote. The fields of the command
  + // come from the request once they are added: put them in ArchiveWidgetRequest.
  + func (c *Controller) ArchiveWidget(ctx context.Context, req *v1.ArchiveWidgetRequest) (*v1.ArchiveWidgetResponse, error) {
  + 	userID, ok := grpcmw.UserIDFromContext(ctx)
  + 	if !ok {
  + 		return nil, status.Error(codes.Unauthenticated, "unauthorized")
  + 	}
  + 
  + 	written, err := cqrs.SendCommand[cqrs.Written](ctx, c.cmds, command.ArchiveWidget{UserID: userID, WidgetID: req.GetId()})
  + 	if err != nil {
  + 		return nil, c.fail(err, "ArchiveWidget")
  + 	}
  + 
  + 	return &v1.ArchiveWidgetResponse{Id: written.ID}, nil
  + }

