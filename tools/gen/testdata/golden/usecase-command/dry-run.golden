  + 
  + // ArchiveWidget resolves Mutation.archiveWidget: it sends ArchiveWidget and answers with the ID it
  + // wrote. The fields of the command come from the field's arguments once they are added.
  + func (m Mutation) ArchiveWidget(ctx context.Context, id string) (string, error) {
  + 	caller, err := middleware.Caller(ctx)
  + 	if err != nil {
  + 		return "", err
  + 	}
  + 
  + 	written, err := cqrs.SendCommand[cqrs.Written](ctx, m.cmds, command.ArchiveWidget{UserID: caller.UserID, WidgetID: id})
  + 	if err != nil {
  + 		return "", gqlerr.Map(m.l, err, "archiveWidget")
  + 	}
  + 
  + 	return written.ID, nil
  + }

