# Stands in for open.er-api.com in the integration tests, so they never call a third party.
# /v6/latest/{base} serves the recorded OMR response the webapi unit test also reads
# (internal/repo/webapi/testdata/openerapi_latest_omr.json, mounted at /srv), so the stub and the
# client cannot drift apart. Point EXCHANGE_SERVICE_URL at http://<host>:8090.
{
	admin off
	auto_https off
}

:8090 {
	# An unknown base currency gets the provider's error, which it sends with HTTP 200.
	handle /v6/latest/XXX {
		header Content-Type application/json
		respond `{"result":"error","error-type":"unsupported-code"}` 200
	}

	handle /v6/latest/* {
		root * /srv
		rewrite * /openerapi_latest_omr.json
		file_server
	}
}
