                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List tasks",
        "tags": [
          "tasks"
        ]
      },
      "post": {
        "description": "Create a new task for the current user",
        "operationId": "create-task",
        "requestBody": {
          "content": {
