ifneq ($(wildcard .env),)
include .env
export
else
$(warning WARNING: .env file not found! Using .env.example)
include .env.example
export
endif

BASE_STACK = docker compose -f docker-compose.yml
INTEGRATION_TEST_STACK = $(BASE_STACK) -f docker-compose-integration-test.yml
ALL_STACK = $(INTEGRATION_TEST_STACK)

# The compose services the app needs on the host: make compose-up starts COMPOSE_SERVICES, make dev
# (scripts/dev.sh reads DEV_SERVICES) and make dev-down add the rest.
COMPOSE_SERVICES = db
COMPOSE_SERVICES += mailpit # scaffold:email
DEV_SERVICES = $(COMPOSE_SERVICES)
DEV_SERVICES += keycloak # scaffold:sso

# Top-level directories holding Go code.
GO_DIRS = $(patsubst %/,%,$(wildcard */))
# scaffold:web:begin
# web/ is excluded: its node_modules can ship .go files. Every frontend target runs Vite+ inside web/.
GO_DIRS := $(filter-out web,$(GO_DIRS))
WEB = vp -C web
# scaffold:web:end
GO_DIRS := $(filter-out scaffold,$(GO_DIRS)) # scaffold:self

# HELP =================================================================================================================
# This will output the help for each task
# thanks to https://marmelab.com/blog/2016/02/29/auto-documented-makefile.html
.PHONY: help

help: ## Display this help screen
	@awk 'BEGIN {FS = ":.*##"; printf "\nUsage:\n  make \033[36m<target>\033[0m\n"} /^[a-zA-Z_-]+:.*?##/ { printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2 } /^##@/ { printf "\n\033[1m%s\033[0m\n", substr($$0, 5) } ' $(MAKEFILE_LIST)

compose-up: ### Run docker compose: the app's dependencies only (without backend and reverse proxy)
	$(BASE_STACK) up --build -d $(COMPOSE_SERVICES) && docker compose logs -f
.PHONY: compose-up

compose-up-all: ### Run docker compose (with backend and reverse proxy)
	$(BASE_STACK) up --build -d
.PHONY: compose-up-all

compose-up-integration-test: ### Run docker compose with integration test
	$(INTEGRATION_TEST_STACK) up --build --abort-on-container-exit --exit-code-from integration-test; exit_code=$$?; \
	$(INTEGRATION_TEST_STACK) down --remove-orphans; exit $$exit_code
.PHONY: compose-up-integration-test

compose-down: ### Down docker compose
	$(ALL_STACK) down --remove-orphans
.PHONY: compose-down

# scaffold:grpc:begin
proto-v1: ### generate source files from proto
	protoc --go_out=. \
		--go_opt=paths=source_relative \
		--go-grpc_out=. \
		--go-grpc_opt=paths=source_relative \
		docs/proto/v1/*.proto
.PHONY: proto-v1

# The protobuf code is generated before anything that builds it.
run: proto-v1
pre-commit: proto-v1
# scaffold:grpc:end

# scaffold:graphql:begin
graphql: ### generate GraphQL server code from schema (gqlgen)
	cd internal/controller/graphql && go tool gqlgen generate
.PHONY: graphql

# scaffold:graphql:end
openapi: ### export the REST OpenAPI document (Huma) to docs/openapi/v1.json
	mkdir -p docs/openapi
	go run ./cmd/openapi > docs/openapi/v1.json.tmp
	mv docs/openapi/v1.json.tmp docs/openapi/v1.json
.PHONY: openapi

# scaffold:web:begin
web-deps: ### install frontend dependencies (Vite+, frozen lockfile)
	$(WEB) install --frozen-lockfile
.PHONY: web-deps

web-api: openapi ### generate the frontend REST types from docs/openapi/v1.json
	$(WEB) exec openapi-typescript ../docs/openapi/v1.json -o src/api/schema.gen.ts
.PHONY: web-api

web-graphql: ### generate the frontend GraphQL types from the gqlgen schema
	$(WEB) exec graphql-codegen --config codegen.ts
.PHONY: web-graphql

web-dev: ### run the Vite+ dev server on WEB_PORT, proxying the API to HTTP_PORT
	$(WEB) dev
.PHONY: web-dev

web-format: ### format and autofix frontend code (Oxfmt + Oxlint)
	$(WEB) check --fix
.PHONY: web-format

web-check: ### format check, lint, type check and unit-test the frontend
	$(WEB) check
	$(WEB) test
.PHONY: web-check

web-build: ### build the frontend into web/dist
	$(WEB) build
.PHONY: web-build

# scaffold:web:end

sqlc: ### render the Atlas HCL schema to SQL, then generate type-safe query code (sqlc)
	{ echo '-- Code generated by make sqlc from internal/app/schema/*.hcl. DO NOT EDIT.'; echo; \
		atlas schema inspect -u file://internal/app/schema --dev-url '$(ATLAS_DEV_URL)' --format '{{ sql . "  " }}'; \
	} > internal/repo/persistent/queries/schema/schema.sql.tmp
	mv internal/repo/persistent/queries/schema/schema.sql.tmp internal/repo/persistent/queries/schema/schema.sql
	go tool sqlc generate
.PHONY: sqlc

deps: ### deps tidy + verify
	go mod tidy && go mod verify
.PHONY: deps

deps-audit: ### check dependencies vulnerabilities
	govulncheck ./...
.PHONY: deps-audit

fix-diff: ### Show code changes by `go fix`
	go fix -diff ./...
.PHONY: fix-diff

format: ### Run code formatter
	go fix ./...
	gofumpt -l -w $(GO_DIRS)
	gci write $(GO_DIRS) --skip-generated -s standard -s default
.PHONY: format

run: deps ### run the app for API v1
	go mod download && \
	CGO_ENABLED=0 go run -tags migrate ./cmd/app
.PHONY: run

# scaffold:queue:begin
run-worker: ### run the queue worker (start the app first: it applies the schema)
	CGO_ENABLED=0 go run ./cmd/worker
.PHONY: run-worker

# scaffold:queue:end
dev: ### run everything in dev mode in tmux: DEV_SERVICES in docker, the rest with hot reload
	./scripts/dev.sh
.PHONY: dev

dev-down: ### stop make dev: close its tmux session, stop DEV_SERVICES
	-tmux kill-session -t =$(notdir $(CURDIR)) 2>/dev/null
	$(BASE_STACK) stop $(DEV_SERVICES)
.PHONY: dev-down

docker-rm-volume: ### remove the Postgres volume (stops the stack)
	$(BASE_STACK) down --volumes --remove-orphans
.PHONY: docker-rm-volume

linter-golangci: ### check by golangci linter
	golangci-lint run
.PHONY: linter-golangci

linter-hadolint: ### check by hadolint linter
	git ls-files --exclude='Dockerfile*' --ignored | xargs hadolint
.PHONY: linter-hadolint

linter-dotenv: ### check by dotenv linter
	dotenv-linter
.PHONY: linter-dotenv

test: ### run test
	go test -v -race -covermode atomic -coverprofile=coverage.txt ./config/... ./internal/... ./pkg/...
.PHONY: test

integration-test: ### run integration-test
	go clean -testcache && go test -v ./integration-test/...
.PHONY: integration-test

mock: ### run mockgen
	mockgen -source ./internal/repo/contracts.go -package usecase_test > ./internal/usecase/mocks_repo_test.go
	mockgen -source ./internal/usecase/contracts.go -package usecase_test > ./internal/usecase/mocks_usecase_test.go
.PHONY: mock

schema-apply: ### apply desired schema to the database (Atlas)
	atlas schema apply -u '$(PG_URL)?sslmode=disable' \
		--to file://internal/app/schema
.PHONY: schema-apply

schema-roundtrip: ### apply the schema up from master, down to it and up again, in a throwaway Postgres container
	./scripts/schema-roundtrip.sh $(BASE_REF)
.PHONY: schema-roundtrip

bin-deps: ### install tools
	go install tool
	@command -v atlas >/dev/null 2>&1 || curl -sSf https://atlasgo.sh | ATLAS_VERSION=v1.3.4 sh
.PHONY: bin-deps

# scaffold:self:begin
# Every scaffold target writes under scaffold/out, a scratch area, so --force is safe there.
SCAFFOLD_ARGS = $(if $(PRESET),--preset $(PRESET)) $(if $(WITH),--with $(WITH)) \
	$(if $(WITHOUT),--without $(WITHOUT)) $(if $(NAME),--name $(NAME)) $(if $(MODULE),--module $(MODULE))

scaffold: ### generate a project with only the features picked: PRESET=, WITH=, WITHOUT= (docs/scaffold.md)
	go run ./cmd/create --force $(SCAFFOLD_ARGS)
.PHONY: scaffold

scaffold-check: ### generate like scaffold, then run make pre-commit inside the generated project
	go run ./cmd/create --force --check $(SCAFFOLD_ARGS)
.PHONY: scaffold-check

# Host ports for scaffold-dev, clear of the root's make dev (and of a Postgres on 5432 or 5433).
SCAFFOLD_DEV_PORTS = PG_PORT=5442 HTTP_PORT=8090 GRPC_PORT=8091 WEB_PORT=3100 SMTP_PORT=1125 \
	MAILPIT_UI_PORT=8125 KEYCLOAK_PORT=8280 \
	WEBAUTHN_RP_ORIGINS=http://localhost,http://localhost:3100,http://localhost:8090

scaffold-dev: ### generate like scaffold, then run make dev inside it on other ports, beside the root's make dev
	go run ./cmd/create --force --then 'make dev $(SCAFFOLD_DEV_PORTS)' $(SCAFFOLD_ARGS)
.PHONY: scaffold-dev

scaffold-matrix: ### generate and make pre-commit every preset, then print a pass/fail summary
	go run ./cmd/create --matrix
.PHONY: scaffold-matrix

scaffold-clean: ### remove the projects generated under scaffold/out
	rm -rf scaffold/out
.PHONY: scaffold-clean

release-version: ### print the next release version from the commits since the last tag, or nothing
	@go run ./cmd/release
.PHONY: release-version

release-notes: ### print the release notes for the commits since the last tag
	@go run ./cmd/release -notes
.PHONY: release-notes

# scaffold:self:end
pre-commit: deps mock format linter-golangci test ### run pre-commit
# scaffold:web:begin
pre-commit: web-api web-graphql web-format web-check
# scaffold:web:end
.PHONY: pre-commit
