enum TaskStatus { TODO IN_PROGRESS DONE }

type Task {
  id: ID!
  userId: ID!
  title: String!
  description: String!
  status: TaskStatus!
  createdAt: Time!
  updatedAt: Time!
  attributes: TaskAttributes!
}

type TaskList { tasks: [Task!]!  total: Int! }

enum TaskPriority { LOW MEDIUM HIGH }

type TaskAttributes {
  priority: TaskPriority
  "In hours."
  estimate: Float
  labels: [String!]
}
