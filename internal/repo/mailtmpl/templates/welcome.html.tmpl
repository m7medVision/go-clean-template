{{define "content" -}}
{{template "heading" "Welcome aboard"}}
{{template "paragraph" (printf "Hi %s," .Username)}}
{{template "paragraph" "Your account is ready. Sign in to start organizing your tasks."}}
{{template "button" (args "URL" .LoginURL "Label" "Sign in")}}
{{template "footnote" "If the button does not work, copy this link into your browser:"}}
<p style="margin:4px 0 0;font-size:14px;line-height:20px;word-break:break-all;"><a href="{{.LoginURL}}" style="color:#18181b;">{{.LoginURL}}</a></p>
{{- end}}
