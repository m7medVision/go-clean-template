{
  "realm": "app",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "app-admin", "description": "Maps to the app's admin role (OIDC_ROLE_MAP)" },
      { "name": "app-user", "description": "Maps to the app's user role (OIDC_ROLE_MAP)" }
    ]
  },
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["app-admin", "app-user"]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["app-user"]
    }
  ],
  "clients": [
    {
      "clientId": "go-clean-template",
      "name": "Go Clean Template",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "go-clean-template-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/sso/callback",
        "http://localhost:3000/sso/callback",
        "http://app.lvh.me/sso/callback"
      ],
      "webOrigins": ["http://localhost", "http://localhost:3000", "http://app.lvh.me"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*##http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles in the ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
